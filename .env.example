# ══════════════════════════════════════════════════════════════
# Sodare — Environment Variables
# Copy this file to .env.local and fill in your values
# ══════════════════════════════════════════════════════════════

# ── Database — Neon PostgreSQL ──
# Pooled connection (PgBouncer) — used by the app at runtime
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct connection — used by Prisma CLI (migrate, push, studio)
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ── NextAuth ──
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# ── Meta / Facebook ──
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_LOGIN_CONFIG_ID=""

# ── Meta API ──
META_API_VERSION="v22.0"

# ── Google Ads OAuth (Sprint 5) ──
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── TikTok Ads OAuth (Sprint 5) ──
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# ── Security ──
INTEGRATION_SECRET=""

# ── Webhooks ──
BOTMAKER_WEBHOOK_SECRET=""

# ── AI Features (Sprint 5) ──
ANTHROPIC_API_KEY=""

# ── Email / Invitations ──
RESEND_API_KEY=""
