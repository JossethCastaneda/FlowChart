# ════════════════════════════════════════════════════════════════════
# SODARE — Variables de entorno (fuente de verdad)
# En producción TODAS viven en Vercel (Project → Settings → Environment
# Variables). Local: copia este archivo a .env y usa una RAMA DEV de Neon,
# nunca producción. Ningún .env.* real debe comitearse (bloqueado en .gitignore).
# ════════════════════════════════════════════════════════════════════

# ── Base de datos (Neon Postgres) ──
# DATABASE_URL = conexión pooled; DIRECT_URL = directa (migraciones/db push)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@host/neondb?sslmode=require"

# ── Autenticación (NextAuth) ──
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generar-con-openssl-rand-base64-32"
AUTH_SECRET="generar-con-openssl-rand-base64-32"

# ── Cifrado de credenciales en reposo (AES-256-GCM) ──
# HEX de 64 caracteres exactos. En producción es OBLIGATORIA (fail-fast).
ENCRYPTION_KEY="generar-con-openssl-rand-hex-32"

# ── Meta (Facebook/Instagram) ──
# El login usa SOLO email,public_profile (FACEBOOK_LOGIN_CONFIG_ID).
# Cada módulo se conecta por separado con su propio config_id (consentimiento
# incremental, requisito del modelo comercial).
FACEBOOK_CLIENT_ID="tu-app-id"
FACEBOOK_CLIENT_SECRET="tu-app-secret"
FACEBOOK_LOGIN_CONFIG_ID="config-id-de-login-basico"
FACEBOOK_PUBLISHER_FB_CONFIG_ID="config-id-publisher-facebook"
FACEBOOK_PUBLISHER_IG_CONFIG_ID="config-id-publisher-instagram"
FACEBOOK_SOCIAL_CONFIG_ID="config-id-social"
FACEBOOK_ADS_CONFIG_ID="config-id-ads"
FACEBOOK_ANALYTICS_CONFIG_ID="config-id-analytics"
FACEBOOK_COMMUNITY_CONFIG_ID="config-id-community"
META_API_VERSION="v25.0"
NEXT_PUBLIC_FB_API_VERSION="v25.0"
META_WEBHOOK_VERIFY_TOKEN="token-de-verificacion-de-webhooks"

# ── Google Hub (OAuth incremental por módulo) ──
GOOGLE_CLIENT_ID="tu-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-client-secret"
GOOGLE_ADS_DEVELOPER_TOKEN="developer-token-de-google-ads"

# ── IA (GridIA — proxy server-side, la key NUNCA llega al cliente) ──
GEMINI_API_KEY="tu-api-key-de-gemini"

# ── Email (Resend) ──
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="SODARE <noreply@sodare.xyz>"
EMAIL_FROM="SODARE <noreply@sodare.xyz>"
# IDs de plantillas (opcionales; si faltan se usa HTML inline)
RESEND_TEMPLATE_PASSWORD_RESET=""
RESEND_TEMPLATE_WORKSPACE_INVITE=""

# ── Almacenamiento de archivos (Vercel Blob) ──
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# ── Botmaker (opcional) ──
BOTMAKER_ACCESS_TOKEN=""
BOTMAKER_BASE_URL="https://api.botmaker.com"

# ── Crons (Vercel Cron auth) ──
CRON_SECRET="secret-para-ejecutar-sincronizaciones"

# ── URLs públicas ──
NEXT_PUBLIC_APP_URL="https://sodare.xyz"
NEXT_PUBLIC_FRONTEND_URL="https://sodare.xyz"
# Si se define, /api/* se proxea a este backend (deployments separados)
# NEXT_PUBLIC_API_URL=""

# ── Analytics propios (opcionales; solo se inyectan si el formato es válido) ──
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
NEXT_PUBLIC_GA4_MEASUREMENT_ID="G-XXXXXXXXXX"

# ── Misceláneos ──
APP_TIMEZONE="America/Mexico_City"
NEXT_PUBLIC_APP_VERSION="2.0.0"
NEXT_PUBLIC_APP_CODENAME=""
