# Core app
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_CODENAME="sodare"
NEXT_PUBLIC_APP_VERSION="0.1.0"

# Database
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
DIRECT_URL=""
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""
STORAGE_DATABASE_URL=""
STORAGE_DATABASE_URL_UNPOOLED=""
STORAGE_POSTGRES_PRISMA_URL=""

# Auth providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Meta Graph API
META_API_VERSION="v25.0"
NEXT_PUBLIC_FB_API_VERSION="v25.0"
FACEBOOK_LOGIN_CONFIG_ID=""
FACEBOOK_PUBLISHER_FB_CONFIG_ID=""
FACEBOOK_PUBLISHER_IG_CONFIG_ID=""
FACEBOOK_ADS_CONFIG_ID=""
FACEBOOK_ANALYTICS_CONFIG_ID=""
FACEBOOK_SOCIAL_CONFIG_ID=""
FACEBOOK_COMMUNITY_CONFIG_ID=""

# Meta webhooks
META_WEBHOOK_VERIFY_TOKEN=""

# ── WhatsApp Business Cloud API (Embedded Signup) ──
# Guía de configuración completa: docs/whatsapp-setup.md
# App Meta usada por el SDK del navegador para el Embedded Signup.
NEXT_PUBLIC_META_APP_ID=""
# config_id del flujo de Embedded Signup de WhatsApp (Meta App → WhatsApp → Embedded Signup).
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=""
# App Secret para verificar el HMAC del webhook de WhatsApp.
# Si WhatsApp usa la MISMA app Meta que FB/IG, deja esto vacío y se usa FACEBOOK_CLIENT_SECRET.
WHATSAPP_APP_SECRET=""
# Verify token del webhook de WhatsApp. Solo necesario si registras el webhook
# dedicado /api/webhooks/whatsapp (app Meta separada para WhatsApp). Si WhatsApp
# comparte app con FB/IG, los eventos llegan a /api/webhooks/meta y basta META_WEBHOOK_VERIFY_TOKEN.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# System User Token permanente (whatsapp_business_management) para listar WABAs de
# clientes vía /{business_id}/client_whatsapp_business_accounts. Opcional.
META_SYSTEM_USER_TOKEN=""
# Business Portfolio ID de Meta Business Manager (dueño de la app de WhatsApp). Opcional.
META_BUSINESS_PORTFOLIO_ID=""

# Security
# ENCRYPTION_KEY: REQUIRED in production — must be exactly 64 hex chars.
# If missing/invalid, token encryption throws instead of storing credentials
# in plain text. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""
CRON_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
RESEND_TEMPLATE_PASSWORD_RESET=""
RESEND_TEMPLATE_WORKSPACE_INVITE=""
EMAIL_FROM=""

# Storage
BLOB_READ_WRITE_TOKEN=""

# AI
GEMINI_API_KEY=""

# BotMaker (conversational analytics) — API v2.0 (header access-token)
# Fallback when no encrypted "botmaker" Integration is configured per workspace.
# NEVER commit a real token. Set this in Vercel env, or connect via Integrations.
BOTMAKER_ACCESS_TOKEN=""
BOTMAKER_REFRESH_TOKEN=""
BOTMAKER_SECRET_ID=""
BOTMAKER_BUSINESS_ID=""
