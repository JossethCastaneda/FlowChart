# ═══════════════════════════════════════════════════════════
# Sodare — Environment Variables
# Copy this file to .env and fill in the values.
# ═══════════════════════════════════════════════════════════

# -- Database (Neon Postgres) --
DATABASE_URL=                     # postgresql://user:pass@host/db?sslmode=require

# -- Auth --
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                  # openssl rand -hex 32
AUTH_SECRET=                      # Same as NEXTAUTH_SECRET (alias)

# -- Encryption (AES-256-GCM for tokens at rest) --
ENCRYPTION_KEY=                   # 64 hex chars: openssl rand -hex 32

# -- Vercel Cron --
CRON_SECRET=                      # openssl rand -hex 32

# -- Meta / Facebook --
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
META_API_VERSION=v25.0
FACEBOOK_ADS_CONFIG_ID=
FACEBOOK_ANALYTICS_CONFIG_ID=
FACEBOOK_COMMUNITY_CONFIG_ID=
FACEBOOK_SOCIAL_CONFIG_ID=
FACEBOOK_PUBLISHER_FB_CONFIG_ID=
FACEBOOK_PUBLISHER_IG_CONFIG_ID=

# -- BotMaker --
BOTMAKER_ACCESS_TOKEN=            # JWT from BotMaker panel

# -- Google Login (NextAuth provider) --
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -- GTM / GA4 (Instrumentación de Sodare, no del cliente) --
NEXT_PUBLIC_GTM_ID=               # GTM-XXXXXXX
NEXT_PUBLIC_GA4_MEASUREMENT_ID=   # G-XXXXXXXXXX

# -- Google Ads (OAuth del cliente) --
GOOGLE_ADS_CLIENT_ID=             # console.cloud.google.com → APIs → Credentials
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=       # Google Ads API Center → MCC account

# -- Google Analytics Data API (OAuth del cliente) --
GOOGLE_ANALYTICS_CLIENT_ID=       # console.cloud.google.com → APIs → Credentials
GOOGLE_ANALYTICS_CLIENT_SECRET=

# -- Google BigQuery --
GOOGLE_BIGQUERY_CLIENT_ID=        # console.cloud.google.com → APIs → Credentials
GOOGLE_BIGQUERY_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=      # Base64-encoded service account JSON (optional alt auth)

# -- TikTok Ads --
TIKTOK_ADS_CLIENT_ID=             # business-api.tiktok.com → My Apps
TIKTOK_ADS_CLIENT_SECRET=

# -- LinkedIn Ads --
LINKEDIN_ADS_CLIENT_ID=           # developer.linkedin.com → My Apps
LINKEDIN_ADS_CLIENT_SECRET=

# -- Pinterest Ads --
PINTEREST_ADS_CLIENT_ID=          # developers.pinterest.com → My Apps
PINTEREST_ADS_CLIENT_SECRET=

# -- Snapchat Ads --
SNAPCHAT_ADS_CLIENT_ID=           # business.snapchat.com → Developer Portal
SNAPCHAT_ADS_CLIENT_SECRET=

# -- X (Twitter) Ads --
X_ADS_CLIENT_ID=                  # developer.x.com → Projects & Apps
X_ADS_CLIENT_SECRET=

# -- Email (Resend) --
RESEND_API_KEY=
