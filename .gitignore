# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never track any variant; only the example template
.env
.env.*
!.env.example

# vercel
.vercel
.env.vercel-*

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# sensitive files
token.txt
meta-api.log
proxy.ts.bak
*.bak

# Log files
*.log

# Local editor/agent artifacts
.claude/
.env*

# Scratch/test scripts — one-off diagnostic files
scratch/
scratch.mts
index.mjs
check-prod-state.cjs
check-posts.ts
check-projects.mjs
check_tokens.js
check_users.js
test_flow.js
test_integrations.js
test_integrations2.js
test_integrations3.mjs
test_login.js
test_puppeteer.js
patch_publisher.js
analytics-results-before-project-scope.patch

# Build cache
.swc/

# Diagnostic / analysis scripts (dangerous — can truncate DB, contain PII)
truncate-db.mjs
botmaker-data.json
_analyze_bots.mjs
check-db.mjs
ts-prune-results.txt
docx_output*.html

# Migration scripts (contain DB credentials)
scripts/migrate-db.mts
scripts/check-id.ts
scripts/list-users.ts
scripts/list-members.ts
scripts/grant-access.ts
scripts/grant-access2.ts
scripts/audit-*.ts
scripts/fix-*.ts
scripts/cleanup-*.ts
scripts/get_users*.js
scripts/reset_users.*
scripts/reset_test_pass.js
scripts/verify_pass.js
scripts/verify_user.ts
scripts/test_error*.js
scripts/test_rate_limit.js

# Obsidian — estado personal de la sesión (no compartir entre máquinas)
docs/.obsidian/workspace.json
docs/.obsidian/workspace-mobile.json
docs/.obsidian/cache

# graphify-out — archivos generados por /graphify
# Ignorar: archivos grandes regenerables (graph.json ~6MB, graph.html ~4.5MB)
graphify-out/graph.html
graphify-out/graph.json
graphify-out/graph.svg
graphify-out/graph.graphml
graphify-out/cypher.txt
graphify-out/obsidian/
graphify-out/wiki/
# Ignorar: archivos internos temporales de graphify
graphify-out/.graphify_*
graphify-out/manifest.json
graphify-out/cache/
# Versionar: GRAPH_REPORT.md (útil para review en PR), cost.json (tracking de tokens)
# NO ignorar: graphify-out/GRAPH_REPORT.md, graphify-out/cost.json
