generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                String            @id @default(cuid())
  name              String?
  email             String?           @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  whatsappPhone     String?
  passwordChangedAt DateTime?
  accounts          Account[]
  auditLogs         AuditLog[]
  capturista        Capturista?
  drafts            DraftPost[]
  integrations      Integration[]     @relation("UserIntegrations")
  mediaAssets       MediaAsset[]
  notifications     Notification[]
  projects          ProjectMember[]
  reports           Report[]
  sessions          Session[]
  sentInvites       WorkspaceInvite[] @relation("SentInvites")
  workspaces        WorkspaceMember[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id                      String                        @id @default(cuid())
  name                    String
  slug                    String                        @unique
  plan                    String                        @default("free")
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  aiRequests              AiRequest[]
  aiReservationLedgers    AiReservationLedger[]
  aiRuns                  AiRun[]
  aiUsages                AiUsage[]
  ariaDatasets            AriaDataset[]
  AssetGroup              AssetGroup[]
  auditLogs               AuditLog[]
  billingCustomer         BillingCustomer?
  billingLedgerEntries    BillingLedgerEntry[]
  billingNotifications    BillingNotification[]
  billingProfile          BillingProfile?
  billingRecoveryCases    BillingRecoveryCase[]
  briefs                  Brief[]
  centurionModels         CenturionModel[]
  contacts                Contact[]
  drafts                  DraftPost[]
  fiscalDocuments         FiscalDocument[]
  conversations           InboxConversation[]
  integrations            Integration[]
  invoices                Invoice[]
  mediaAssets             MediaAsset[]
  metaAnalyticsCache      MetaAnalyticsCache[]
  mmmWeeklySpend          MmmWeeklySpend[]
  ModelDecision           ModelDecision[]
  objectives              Objective[]
  optimizationApprovals   OptimizationActionApproval[]
  optimizationExecutions  OptimizationActionExecution[]
  optimizationResults     OptimizationAnalysisResult[]
  optimizationAuditEvents OptimizationAuditEvent[]
  optimizationClients     OptimizationClient[]
  optimizationEvaluations OptimizationEvaluation[]
  optimizationObjectives  OptimizationObjective[]
  optimizationActions     OptimizationProposedAction[]
  optimizationSnapshots   OptimizationSnapshot[]
  projects                Project[]
  reports                 Report[]
  posts                   ScheduledPost[]
  streamBoards            StreamBoard[]
  subscription            Subscription?
  tasks                   Task[]
  trackedKeywords         TrackedKeyword[]
  transmissions           Transmission[]
  waPhoneSources          WaPhoneSource[]
  aiBudgetBalances        WorkspaceAiBudgetBalance[]
  entitlement             WorkspaceEntitlement?
  invites                 WorkspaceInvite[]
  members                 WorkspaceMember[]
  settings                WorkspaceSettings?
}

model WorkspaceSettings {
  id                String    @id @default(cuid())
  workspaceId       String    @unique
  areas             Json      @default("[]")
  requireLeadReview Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  branding          Json      @default("{}")
  extConfig         Json      @default("{}")
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceMember {
  id             String    @id @default(cuid())
  workspaceId    String
  userId         String
  role           String    @default("MEMBER")
  activityStatus String    @default("disponible")
  lastActiveAt   DateTime  @default(now())
  permissions    Json?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  token       String    @unique
  role        String    @default("MEMBER")
  expires     DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  invitedById String?
  invitedBy   User?     @relation("SentInvites", fields: [invitedById], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, email])
  @@index([workspaceId, acceptedAt])
}

model Project {
  id                      String                     @id @default(cuid())
  name                    String
  alias                   String?
  client                  String?
  vertical                String?
  fanpage                 String[]
  instagram               String[]
  whatsapp                String[]
  website                 String?
  persona                 String?
  geo                     String?
  status                  String                     @default("Activo")
  dateStart               String?
  dateEnd                 String?
  workspaceId             String
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  alertsEnabled           Boolean                    @default(true)
  alertEmails             String[]
  crmIntegrationId        String?
  crmType                 String?
  /// CRMs conectados al proyecto (ids de Integration). Un proyecto puede enviar
  /// tr├ífico a varias herramientas (ej. botmaker + cari) y el an├ílisis de
  /// resultados se segmenta por cada una de forma independiente.
  crmIntegrationIds       String[]                   @default([])
  webchat                 String[]
  publicToken             String?                    @unique
  /// Tipo de flujo del bot (metodolog├¡a BAIT) para el Funnel 2 por bot:
  /// prepago | pospago_alineado | pospago_simplificado | google_bait. Vac├¡o = auto.
  botFlowType             String?
  /// Recursos de Google vinculados a este proyecto (por proyecto, no por workspace).
  /// Estructura: { adsCustomerId, ga4PropertyId, gtmAccountId, gtmContainerId }
  /// Permite que cada proyecto del cliente use sus propias cuentas de Google.
  googleSources           Json?                      @default("{}")
  ariaDatasets            AriaDataset[]
  briefs                  Brief[]
  channels                Channel[]
  drafts                  DraftPost[]
  googleSourceLinks       GoogleSource[]             @relation("ProjectGoogleSources")
  mediaAssets             MediaAsset[]
  metaSources             MetaSource[]
  optimizationClientLinks OptimizationClientProject?
  workspace               Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  alerts                  ProjectAlert[]
  members                 ProjectMember[]
  reports                 Report[]
  waPhoneSources          WaPhoneSource[]

  @@unique([workspaceId, id])
}

model MetaSource {
  id         String   @id @default(cuid())
  externalId String
  kind       String
  projectId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([externalId, projectId])
  @@index([externalId])
}

model WaPhoneSource {
  id            String    @id @default(cuid())
  phoneNumberId String    @unique
  workspaceId   String
  projectId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  project       Project?  @relation(fields: [projectId], references: [id])
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([phoneNumberId])
}

model GoogleSource {
  id         String   @id @default(cuid())
  externalId String
  kind       String
  projectId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation("ProjectGoogleSources", fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([externalId, projectId])
  @@index([externalId])
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  userId    String
  role      String  @default("MEMBER")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Capturista {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Channel {
  id        String  @id @default(cuid())
  projectId String
  name      String
  type      String
  config    Json?
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Objective {
  id          String      @id @default(cuid())
  workspaceId String
  areaId      String?
  title       String
  description String?
  quarter     String
  status      String      @default("active")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  keyResults  KeyResult[]
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, areaId])
}

model KeyResult {
  id           String    @id @default(cuid())
  objectiveId  String
  title        String
  targetValue  Float
  currentValue Float     @default(0)
  unit         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  objective    Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@index([objectiveId])
}

model Task {
  id                      String         @id @default(cuid())
  title                   String
  description             String?
  assignee                String?
  priority                String         @default("P2")
  status                  String         @default("Backlog")
  dueDate                 DateTime?
  tags                    String[]
  order                   Int            @default(0)
  attachments             Json           @default("[]")
  projectId               String?
  parentId                String?
  createdBy               String?
  workspaceId             String
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  requestType             String?
  requesterId             String?
  targetAreaId            String?
  closedAt                DateTime?
  assigneeId              String?
  keyResultId             String?
  estimate                Float?
  startDate               DateTime?
  /// null = sin revisi├│n pendiente | "pending" | "approved" | "rejected"
  approvalState           String?
  briefId                 String?
  /// Usuario que la tiene detenida en el momento del ├║ltimo avance: el
  /// responsable si est├í en curso, o el l├¡der si espera aprobaci├│n.
  holderId                String?
  /// ├Ültimo avance real (cambio de estado o de responsable). Base para medir
  /// cu├ínto lleva detenida y en manos de qui├®n.
  lastProgressAt          DateTime       @default(now())
  rejectionNote           String?
  reviewedAt              DateTime?
  reviewedById            String?
  reworkCount             Int            @default(0)
  submittedAt             DateTime?
  submittedById           String?
  brief                   Brief?         @relation(fields: [briefId], references: [id])
  keyResult               KeyResult?     @relation(fields: [keyResultId], references: [id])
  parent                  Task?          @relation("SubTasks", fields: [parentId], references: [id], onDelete: Cascade)
  children                Task[]         @relation("SubTasks")
  workspace               Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  activities              TaskActivity[]
  comments                TaskComment[]
  Task_TaskDependencies_A Task[]         @relation("TaskDependencies")
  Task_TaskDependencies_B Task[]         @relation("TaskDependencies")

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([parentId])
  @@index([briefId])
  @@index([workspaceId, approvalState])
  @@index([workspaceId, lastProgressAt])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  userName  String
  userImage String?
  content   String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  userName  String
  action    String
  field     String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Brief {
  id          String    @id @default(cuid())
  workspaceId String
  projectId   String?
  title       String
  content     Json      @default("{}")
  status      String    @default("Draft")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project?  @relation(fields: [projectId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([workspaceId])
  @@index([workspaceId, status])
}

model MediaAsset {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String?
  url         String
  fileName    String
  mimeType    String
  size        Int
  width       Int?
  height      Int?
  status      String    @default("ready")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projectId   String?
  tags        String[]  @default([])
  project     Project?  @relation(fields: [projectId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, projectId])
}

model DraftPost {
  id               String         @id @default(cuid())
  workspaceId      String
  projectId        String?
  authorId         String?
  baseContent      String
  baseMediaUrls    String[]
  channelOverrides Json           @default("{}")
  status           String         @default("draft")
  scheduledAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  author           User?          @relation(fields: [authorId], references: [id])
  project          Project?       @relation(fields: [projectId], references: [id])
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transmissions    Transmission[]

  @@index([workspaceId, status])
  @@index([scheduledAt])
}

model Transmission {
  id             String       @id @default(cuid())
  draftId        String
  workspaceId    String
  channel        String
  accountId      String
  accountName    String?
  status         String       @default("pending")
  scheduledAt    DateTime?
  publishedAt    DateTime?
  finalContent   String
  finalMediaUrls String[]
  externalPostId String?
  externalUrl    String?
  errorMessage   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  jobs           PublishJob[]
  draft          DraftPost    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([draftId])
  @@index([workspaceId, status])
  @@index([scheduledAt])
}

model PublishJob {
  id             String       @id @default(cuid())
  transmissionId String
  step           String
  status         String       @default("pending")
  attempts       Int          @default(0)
  maxAttempts    Int          @default(3)
  nextAttemptAt  DateTime?
  payload        Json?
  result         Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  transmission   Transmission @relation(fields: [transmissionId], references: [id], onDelete: Cascade)

  @@index([transmissionId])
  @@index([status, nextAttemptAt])
}

model AuditLog {
  id           String    @id @default(cuid())
  workspaceId  String
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  user         User?     @relation(fields: [userId], references: [id])
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, action])
  @@index([workspaceId, createdAt])
}

model ScheduledPost {
  id                String    @id @default(cuid())
  workspaceId       String
  projectId         String?
  userId            String?
  channels          String[]
  content           String
  mediaUrls         String[]
  mediaUrl          String?
  type              String    @default("post")
  hashtags          String[]
  scheduledAt       DateTime?
  publishedAt       DateTime?
  status            String    @default("Draft")
  error             String?
  externalIds       Json?
  pageName          String?
  pageId            String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  contentByPlatform Json?
  firstComment      String?
  qStashMessageId   String?
  approvalStatus    String?
  approvedAt        DateTime?
  approvedById      String?
  reviewNote        String?
  targets           Json?
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([scheduledAt])
  @@index([qStashMessageId])
}

model Integration {
  id            String    @id @default(cuid())
  workspaceId   String
  provider      String
  credentials   Json
  connected     Boolean   @default(false)
  connectedAt   DateTime?
  connectedBy   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  /// "workspace" ÔåÆ workspace-level integration (OWNER/ADMIN shared, e.g. meta_ads, google)
  /// userId     ÔåÆ user-level integration (each member connects their own account independently)
  userId        String?   @default("workspace")
  config        Json?     @default("{}")
  name          String?
  connectedUser User?     @relation("UserIntegrations", fields: [connectedBy], references: [id])
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, userId])
  @@index([workspaceId, userId])
  @@index([workspaceId, provider])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
}

model ProjectAlert {
  id        String   @id @default(cuid())
  projectId String
  type      String
  severity  String
  title     String
  message   String
  emailSent Boolean  @default(false)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
}

model InboxConversation {
  id            String         @id @default(cuid())
  workspaceId   String
  platform      String
  externalId    String
  contactName   String?
  contactAvatar String?
  lastMessage   String?
  lastMessageAt DateTime?
  unread        Boolean        @default(true)
  assignedTo    String?
  status        String         @default("open")
  tags          String[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  pageId        String?
  igId          String?
  contactId     String?
  priority      Boolean        @default(false)
  contact       Contact?       @relation(fields: [contactId], references: [id])
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages      InboxMessage[]
  notes         InboxNote[]

  @@unique([workspaceId, externalId])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([contactId])
}

model Contact {
  id              String              @id @default(cuid())
  workspaceId     String
  name            String?
  email           String?
  phone           String?
  avatar          String?
  company         String?
  /// lead | prospect | customer | evangelist | other
  lifecycleStage  String              @default("lead")
  ownerId         String?
  tags            String[]
  customFields    Json                @default("{}")
  notes           String?
  lastContactedAt DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channels        ContactChannel[]
  conversations   InboxConversation[]

  @@index([workspaceId])
  @@index([workspaceId, lifecycleStage])
  @@index([workspaceId, ownerId])
}

model ContactChannel {
  id          String   @id @default(cuid())
  contactId   String
  workspaceId String
  platform    String
  externalId  String
  handle      String?
  createdAt   DateTime @default(now())
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform, externalId])
  @@index([contactId])
  @@index([workspaceId])
}

model InboxMessage {
  id             String            @id @default(cuid())
  conversationId String
  externalId     String?
  content        String
  sender         String
  senderName     String?
  senderAvatar   String?
  attachments    Json?
  createdAt      DateTime          @default(now())
  reaction       String?
  deliveredAt    DateTime?
  readAt         DateTime?
  editedAt       DateTime?
  isEdited       Boolean           @default(false)
  replyToId      String?
  conversation   InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, externalId])
  @@index([conversationId])
}

model SavedReply {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  content     String
  shortcut    String?
  createdAt   DateTime @default(now())

  @@index([workspaceId])
}

model InboxNote {
  id             String            @id @default(cuid())
  conversationId String
  userId         String
  content        String
  createdAt      DateTime          @default(now())
  conversation   InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model DmAutomationRule {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  trigger     String
  response    String
  platforms   String[]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, active])
}

model TrackedKeyword {
  id          String    @id @default(cuid())
  workspaceId String
  query       String
  type        String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, query])
  @@index([workspaceId])
}

model ListeningQuery {
  id          String             @id @default(cuid())
  workspaceId String
  query       String
  type        String
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  mentions    ListeningMention[]

  @@index([workspaceId])
}

model ListeningMention {
  id           String         @id @default(cuid())
  queryId      String
  platform     String
  content      String
  author       String?
  authorAvatar String?
  sentiment    String?
  url          String?
  publishedAt  DateTime
  createdAt    DateTime       @default(now())
  query        ListeningQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@index([queryId])
  @@index([publishedAt])
}

model StreamBoard {
  id          String         @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns     StreamColumn[]

  @@index([workspaceId])
}

model StreamColumn {
  id        String      @id @default(cuid())
  boardId   String
  type      String
  platform  String
  query     String?
  position  Int         @default(0)
  createdAt DateTime    @default(now())
  board     StreamBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
}

model DataDeletionRequest {
  id               String    @id @default(cuid())
  confirmationCode String    @unique @default(cuid())
  metaUserId       String
  status           String    @default("pending")
  requestedAt      DateTime  @default(now())
  completedAt      DateTime?

  @@index([metaUserId])
  @@index([status])
}

model MetaAdsCache {
  id          String   @id @default(cuid())
  adAccountId String
  level       String
  dateRange   String
  data        Json
  updatedAt   DateTime @updatedAt
  workspaceId String   @default("")

  @@unique([workspaceId, adAccountId, level, dateRange])
  @@index([workspaceId, adAccountId])
}

model GoogleAdsCache {
