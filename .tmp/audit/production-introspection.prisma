/// Representa una solicitud comercial de cambio de compa├▒├¡a / portabilidad.
model BotmakerLeadRequest {
  id                 String                      @id @default(cuid())
  requestId          String                      @unique @default(cuid())
  sessionId          String
  customerId         String?
  botId              String?
  channelId          String?
  platform           String?
  workspaceId        String
  /// whatsapp | messenger | comment | webchat | unknown
  sourceKind         String                      @default("unknown")
  /// prepago | pospago | unknown
  productType        String                      @default("unknown")
  /// started | collecting_data | ocr_pending | ocr_success | ocr_failed |
  /// data_confirmed | sent_to_intelix | intelix_accepted | intelix_rejected |
  /// zapier_sent | zapier_failed | ads_attributed | abandoned | stuck
  leadStatus         String                      @default("started")
  startedAt          DateTime                    @default(now())
  completedAt        DateTime?
  abandonedAt        DateTime?
  lastStepAt         DateTime?
  lastStepName       String?
  lastIntentName     String?
  lastFlowState      String?
  errorSource        String?
  errorCode          String?
  errorMessage       String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  fieldSnapshots     BotmakerLeadFieldSnapshot[]
  ocrExtractions     BotmakerOcrExtraction[]
  intelixSubmissions IntelixSubmission[]
  zapierEvents       ZapierConversionEvent[]

  @@index([workspaceId, leadStatus])
  @@index([workspaceId, sessionId])
  @@index([workspaceId, customerId])
  @@index([workspaceId, botId])
  @@index([workspaceId, channelId])
  @@index([workspaceId, productType])
  @@index([workspaceId, createdAt])
}

/// Guarda campos capturados y sus alias para cada solicitud.
model BotmakerLeadFieldSnapshot {
  id                 String              @id @default(cuid())
  leadRequestId      String
  sessionId          String?
  customerId         String?
  /// Nombre can├│nico del campo:
  /// name | last_name | full_name | phone_to_change | nip | nip_expiration_date
  /// birth_date | birth_state | email | ocr_image_url | ga_cid | ig_post_id
  /// from_name | zapier_status | zapier_response | flow_state | raw_nip_detected
  canonicalField     String
  sourceVariableName String?
  rawValue           String?
  maskedValue        String?
  normalizedValue    String?
  isPresent          Boolean             @default(false)
  isValid            Boolean             @default(false)
  validationError    String?
  capturedAt         DateTime?
  messageId          String?
  rawPayload         Json?
  leadRequest        BotmakerLeadRequest @relation(fields: [leadRequestId], references: [id], onDelete: Cascade)

  @@index([leadRequestId])
  @@index([leadRequestId, canonicalField])
  @@index([sessionId])
}

/// Guarda trazabilidad de extracciones OCR.
model BotmakerOcrExtraction {
  id                         String              @id @default(cuid())
  leadRequestId              String
  sessionId                  String?
  customerId                 String?
  ocrImageUrl                String?
  detectedRawText            String?
  detectedNipRaw             String?
  extractedNip               String?
  extractedNipExpirationDate String?
  /// pending | success | partial | failed
  extractionStatus           String              @default("pending")
  extractionError            String?
  codeActionName             String?
  executedAt                 DateTime?
  rawPayload                 Json?
  leadRequest                BotmakerLeadRequest @relation(fields: [leadRequestId], references: [id], onDelete: Cascade)

  @@index([leadRequestId])
  @@index([sessionId])
  @@index([extractionStatus])
}

/// Guarda cada intento de env├¡o a Intelix (CRM de portabilidad).
model IntelixSubmission {
  id                     String              @id @default(cuid())
  leadRequestId          String
  sessionId              String?
  customerId             String?
  /// prepago | pospago | unknown
  productType            String              @default("unknown")
  submittedAt            DateTime?
  requestPayload         Json?
  responsePayload        Json?
  /// accepted | rejected | error | timeout | unknown
  status                 String              @default("unknown")
  crmAcceptanceCondition String?
  intelixFolio           String?
  intelixErrorCode       String?
  intelixErrorMessage    String?
  latencyMs              Int?
  retryCount             Int                 @default(0)
  createdAt              DateTime            @default(now())
  leadRequest            BotmakerLeadRequest @relation(fields: [leadRequestId], references: [id], onDelete: Cascade)

  @@index([leadRequestId])
  @@index([sessionId])
  @@index([status])
  @@index([createdAt])
}

/// Guarda trazabilidad de eventos Zapier y atribuci├│n Ads.
model ZapierConversionEvent {
  id             String              @id @default(cuid())
