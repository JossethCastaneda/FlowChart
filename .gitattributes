# Auto-detect text files and normalise line endings
* text=auto

# Ensure consistent LF for documentation and source
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# Prisma checksums are byte-sensitive. Keep canonical and forensic SQL stable
# across Windows, macOS, and Linux checkouts.
prisma/schema.prisma text eol=lf
prisma/migrations/**/*.sql text eol=lf
# The forensic archive intentionally preserves the original mixed line endings.
# Treat it as binary so Git neither normalizes nor flags historical CRLF bytes.
docs/migrations/legacy/**/*.sql binary
