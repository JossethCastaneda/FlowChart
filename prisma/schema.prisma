// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: url + directUrl are in prisma.config.ts (required by Prisma 7)
  // DATABASE_URL → pooled Neon connection
  // DIRECT_URL  → direct Neon connection (for migrations)
}

// ------------------------------------------------------
// NEXTAUTH MODELS
// ------------------------------------------------------
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // null para usuarios OAuth (Facebook/Google)
  accounts      Account[]
  sessions      Session[]
  
  // Relations
  workspaces    WorkspaceMember[]
  projects      ProjectMember[]
  capturista    Capturista?
  integrations  Integration[]     @relation("UserIntegrations")
  notifications Notification[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------------------------------
// WORKSPACE & MULTI-TENANT
// ------------------------------------------------------

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("free") // free, pro, agency
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      WorkspaceMember[]
  projects     Project[]
  invites      WorkspaceInvite[]
  tasks        Task[]
  briefs       Brief[]
  posts        ScheduledPost[]
  integrations Integration[]
  conversations InboxConversation[]
  streamBoards    StreamBoard[]
  trackedKeywords TrackedKeyword[]
  settings        WorkspaceSettings?
}

// ------------------------------------------------------
// WORKFLOW / AREAS (agency org chart + SLA config)
// ------------------------------------------------------
// Stored as JSON so each workspace can model its own areas, leads, members,
// per-area SLA and request types — fully editable from Admin → Áreas y flujos.
//
// areas shape: [{
//   id, name, color, slaHours, leadIds: string[], memberIds: string[],
//   requestTypes: [{ id, name, slaHours }]
// }]
model WorkspaceSettings {
  id                String   @id @default(cuid())
  workspaceId       String   @unique
  areas             Json     @default("[]")
  requireLeadReview Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceMember {
  id              String   @id @default(cuid())
  workspaceId     String
  userId          String
  role            String   @default("MEMBER") // OWNER, ADMIN, MEMBER
  activityStatus  String   @default("disponible") // disponible | ocupado | ausente | offline
  lastActiveAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  token       String    @unique
  role        String    @default("MEMBER")
  expires     DateTime
  acceptedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// PROJECT & CHANNELS
// ------------------------------------------------------

model Project {
  id          String   @id @default(cuid())
  name        String
  alias       String?
  client      String?
  vertical    String?
  fanpage     String[]
  instagram   String[]
  whatsapp    String[]
  website     String?
  persona     String?  @db.Text
  geo         String?
  status      String   @default("Activo") // Activo, Pausado, Draft, Completado
  dateStart   String?
  dateEnd     String?
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members       ProjectMember[]
  channels      Channel[]
  briefs        Brief[]
  alerts        ProjectAlert[]
  alertsEnabled Boolean  @default(true)
  alertEmails   String[]
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("MEMBER")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Capturista {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Channel {
  id        String   @id @default(cuid())
  projectId String
  name      String
  type      String   // FACEBOOK, INSTAGRAM, WHATSAPP, etc.
  config    Json?
  
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// OPS / TASKS
// ------------------------------------------------------

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  assignee    String?
  priority    String   @default("P2")  // P0, P1, P2, P3
  status      String   @default("Backlog") // Backlog, WIP, Review, Done
  dueDate     DateTime?
  tags        String[]
  order       Int      @default(0)
  attachments Json     @default("[]") // [{name, url, type, size, uploadedAt}]
  projectId   String?
  parentId    String?
  createdBy   String?  // userId who created the task
  // ── Cross-area request (Capa 3): a task with targetAreaId is a "solicitud" ──
  targetAreaId String? // area the request is routed to (id from WorkspaceSettings.areas)
  requestType  String? // request type label/id within the target area
  requesterId  String? // userId who raised the request
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  closedAt    DateTime? // stamped when status → Done (for auto-SLA)

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent      Task?     @relation("SubTasks", fields: [parentId], references: [id], onDelete: Cascade)
  children    Task[]    @relation("SubTasks")
  comments    TaskComment[]
  activities  TaskActivity[]

  @@index([workspaceId])
  @@index([parentId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  userName  String   // denormalized for display
  userImage String?  // denormalized avatar
  content   String   @db.Text
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  userName  String
  action    String   // "created", "status_changed", "assigned", "priority_changed", "commented", "attachment_added"
  field     String?  // which field changed
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}
// ------------------------------------------------------

model Brief {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String?
  title       String
  content     Json     @default("{}")
  status      String   @default("Draft") // Draft, Review, Approved
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

// ------------------------------------------------------
// PUBLISHER / SCHEDULING
// ------------------------------------------------------

model ScheduledPost {
  id           String   @id @default(cuid())
  workspaceId  String
  projectId    String?
  userId       String?  // who created this post
  channels     String[] // ["facebook", "instagram", "tiktok", "linkedin"]
  content      String   @db.Text
  contentByPlatform Json? // { "facebook": "...", "instagram": "..." }
  firstComment String?  @db.Text // Auto-posted as first comment on IG after publish
  mediaUrls    String[] // multiple media files
  mediaUrl     String?  // legacy single media (kept for compat)
  type         String   @default("post") // post, reel, story, carousel
  hashtags     String[]
  scheduledAt  DateTime?
  publishedAt  DateTime?
  status       String   @default("Draft") // Draft, Scheduled, Published, Failed
  error        String?  @db.Text // error message if publish failed
  externalIds  Json?    // { facebook: "post_id", instagram: "media_id" }
  pageName     String?  // Facebook page name used
  pageId       String?  // Facebook page ID used
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([scheduledAt])
}


// ------------------------------------------------------
// INTEGRATIONS
// ------------------------------------------------------

model Integration {
  id            String    @id @default(cuid())
  workspaceId   String
  provider      String    // "meta", "google_ads", "tiktok", "whatsapp"
  credentials   Json      // Encrypted with AES-256
  connected     Boolean   @default(false)
  connectedAt   DateTime?
  connectedBy   String?   // userId of who connected this integration
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedUser User?     @relation("UserIntegrations", fields: [connectedBy], references: [id], onDelete: SetNull)

  @@unique([workspaceId, provider])
}

// ------------------------------------------------------
// NOTIFICATIONS
// ------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // task_assigned, sla_warning, sla_expired, status_changed, mention
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
}

// ------------------------------------------------------
// PROJECT ALERTS
// ------------------------------------------------------

model ProjectAlert {
  id          String   @id @default(cuid())
  projectId   String
  type        String   // health_score, cpr_spike, frequency_high, budget_pace, ctr_drop
  severity    String   // critical, warning, info
  title       String
  message     String   @db.Text
  emailSent   Boolean  @default(false)
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
}

// ------------------------------------------------------
// INBOX 2.0
// ------------------------------------------------------

model InboxConversation {
  id            String   @id @default(cuid())
  workspaceId   String
  platform      String   // "facebook_messenger", "instagram_dm", "instagram_comment"
  externalId    String   // Conversation ID from Meta
  pageId        String?  // Facebook Page ID or IG user ID
  contactName   String?
  contactAvatar String?
  lastMessage   String?
  lastMessageAt DateTime?
  unread        Boolean  @default(true)
  assignedTo    String?  // userId
  status        String   @default("open") // "open", "closed", "assigned"
  tags          String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages      InboxMessage[]
  notes         InboxNote[]

  @@unique([workspaceId, externalId])
  @@index([workspaceId])
  @@index([workspaceId, status])
}

model InboxMessage {
  id              String   @id @default(cuid())
  conversationId  String
  externalId      String?
  content         String   @db.Text
  sender          String   // "user" | "page"
  senderName      String?
  senderAvatar    String?
  attachments     Json?
  createdAt       DateTime @default(now())

  conversation    InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model SavedReply {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  content     String   @db.Text
  shortcut    String?  // e.g., "/gracias"
  createdAt   DateTime @default(now())

  @@index([workspaceId])
}

model InboxNote {
  id             String            @id @default(cuid())
  conversationId String
  userId         String
  content        String            @db.Text
  createdAt      DateTime          @default(now())

  conversation   InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model DmAutomationRule {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  trigger     String   // keyword that activates the rule
  response    String   @db.Text // auto-reply message
  platforms   String[] // ["messenger", "instagram_dm"]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, active])
}

model BestTimeCache {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  data        Json     // { slots: [{day, hour, avgImpressions}], generatedAt }
  generatedAt DateTime

  @@index([workspaceId])
}

model TrackedKeyword {
  id          String   @id @default(cuid())
  workspaceId String
  query       String
  type        String   // "keyword" | "hashtag" | "competitor"
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, query])
  @@index([workspaceId])
}

model HashtagCache {
  id          String   @id @default(cuid())
  workspaceId String
  hashtag     String
  igHashtagId String
  expiresAt   DateTime
  @@unique([workspaceId, hashtag])
}

// ------------------------------------------------------
// SOCIAL LISTENING
// ------------------------------------------------------

model ListeningQuery {
  id          String   @id @default(cuid())
  workspaceId String
  query       String   // keyword or hashtag
  type        String   // "keyword", "hashtag", "competitor"
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  mentions    ListeningMention[]

  @@index([workspaceId])
}

model ListeningMention {
  id          String   @id @default(cuid())
  queryId     String
  platform    String
  content     String   @db.Text
  author      String?
  authorAvatar String?
  sentiment   String?  // "positive", "negative", "neutral"
  url         String?
  publishedAt DateTime
  createdAt   DateTime @default(now())

  query       ListeningQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@index([queryId])
  @@index([publishedAt])
}

// ------------------------------------------------------
// STREAMS (Real-time monitoring)
// ------------------------------------------------------

model StreamBoard {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns     StreamColumn[]

  @@index([workspaceId])
}

model StreamColumn {
  id        String   @id @default(cuid())
  boardId   String
  type      String   // "home_feed", "mentions", "keyword", "hashtag", "scheduled", "published"
  platform  String   // "facebook", "instagram", "tiktok", "linkedin", "x"
  query     String?  // keyword or hashtag for tracking
  position  Int      @default(0)
  createdAt DateTime @default(now())

  board     StreamBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
}

// ------------------------------------------------------
// META DATA DELETION REQUESTS (GDPR compliance)
// ------------------------------------------------------
// Tracks user data deletion requests received via Meta's
// Data Deletion Callback. Each request must be acknowledged
// and the data deleted asynchronously.

model DataDeletionRequest {
  id               String   @id @default(cuid())
  confirmationCode String   @unique @default(cuid())
  metaUserId       String   // Facebook user_id from signed_request
  status           String   @default("pending") // pending | processing | completed | failed
  requestedAt      DateTime @default(now())
  completedAt      DateTime?

  @@index([metaUserId])
  @@index([status])
}
