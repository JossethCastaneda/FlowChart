// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: url + directUrl are in prisma.config.ts (required by Prisma 7)
  // DATABASE_URL → pooled Neon connection
  // DIRECT_URL  → direct Neon connection (for migrations)
}

// ------------------------------------------------------
// NEXTAUTH MODELS
// ------------------------------------------------------
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String?   @unique
  emailVerified     DateTime?
  image             String?
  password          String? // null para usuarios OAuth (Facebook/Google)
  // Marca de cambio de contraseña: invalida sesiones JWT emitidas antes de esta
  // fecha (se compara contra token.loginAt en withAuth). Cambia en reset/change.
  passwordChangedAt DateTime?
  whatsappPhone     String? // número personal para notificaciones WA (ej. "5215512345678")
  accounts          Account[]
  sessions          Session[]

  // Relations
  workspaces    WorkspaceMember[]
  projects      ProjectMember[]
  capturista    Capturista?
  integrations  Integration[]     @relation("UserIntegrations")
  notifications Notification[]
  sentInvites   WorkspaceInvite[] @relation("SentInvites")
  mediaAssets   MediaAsset[]
  drafts        DraftPost[]
  auditLogs     AuditLog[]
  reports       Report[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------------------------------
// WORKSPACE & MULTI-TENANT
// ------------------------------------------------------

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("free") // free, pro, agency
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members                 WorkspaceMember[]
  projects                Project[]
  invites                 WorkspaceInvite[]
  tasks                   Task[]
  briefs                  Brief[]
  posts                   ScheduledPost[]
  integrations            Integration[]
  conversations           InboxConversation[]
  streamBoards            StreamBoard[]
  trackedKeywords         TrackedKeyword[]
  settings                WorkspaceSettings?
  waPhoneSources          WaPhoneSource[]
  metaAnalyticsCache      MetaAnalyticsCache[]
  mediaAssets             MediaAsset[]
  drafts                  DraftPost[]
  transmissions           Transmission[]
  auditLogs               AuditLog[]
  objectives              Objective[]
  ariaDatasets            AriaDataset[]
  centurionModels         CenturionModel[]
  mmmWeeklySpend          MmmWeeklySpend[]
  reports                 Report[]
  aiUsages                AiUsage[]
  contacts                Contact[]
  optimizationClients     OptimizationClient[]
  optimizationObjectives  OptimizationObjective[]
  optimizationSnapshots   OptimizationSnapshot[]
  optimizationResults     OptimizationAnalysisResult[]
  optimizationActions     OptimizationProposedAction[]
  optimizationEvaluations OptimizationEvaluation[]
  optimizationApprovals   OptimizationActionApproval[]
  optimizationExecutions  OptimizationActionExecution[]
  optimizationAuditEvents OptimizationAuditEvent[]
  aiRequests              AiRequest[]
  aiRuns                  AiRun[]
  entitlement             WorkspaceEntitlement?
  billingCustomer         BillingCustomer?
  subscription            Subscription?
  invoices                Invoice[]
  aiReservationLedgers    AiReservationLedger[]
  aiBudgetBalances        WorkspaceAiBudgetBalance[]
  billingLedgerEntries    BillingLedgerEntry[]
  billingProfile          BillingProfile?
  fiscalDocuments         FiscalDocument[]
  billingNotifications    BillingNotification[]
  billingRecoveryCases    BillingRecoveryCase[]
}

// ------------------------------------------------------
// WORKFLOW / AREAS (agency org chart + SLA config)
// ------------------------------------------------------
// Stored as JSON so each workspace can model its own areas, leads, members,
// per-area SLA and request types — fully editable from Admin → Áreas y flujos.
//
// areas shape: [{
//   id, name, color, slaHours, leadIds: string[], memberIds: string[],
//   requestTypes: [{ id, name, slaHours }]
// }]
model WorkspaceSettings {
  id                String   @id @default(cuid())
  workspaceId       String   @unique
  areas             Json     @default("[]")
  requireLeadReview Boolean  @default(true)
  // Branding por workspace: { logoUrl?, accentColor?, displayName? }
  // Validado con BrandingSchema (lib/workflow-config.ts) al escribir.
  branding          Json     @default("{}")
  // Config extendida para modulos adicionales (ej. mmm, forecasting)
  extConfig         Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkspaceMember {
  id             String   @id @default(cuid())
  workspaceId    String
  userId         String
  role           String   @default("MEMBER") // OWNER, ADMIN, MEMBER
  activityStatus String   @default("disponible") // disponible | ocupado | ausente | offline
  lastActiveAt   DateTime @default(now())
  permissions    Json? // Module-level granular permissions (overrides area defaults)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  token       String    @unique
  role        String    @default("MEMBER")
  expires     DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  invitedById String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("SentInvites", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, email]) // for pending invite lookups per workspace
  @@index([workspaceId, acceptedAt]) // for listing pending invites
}

// ------------------------------------------------------
// PROJECT & CHANNELS
// ------------------------------------------------------

model Project {
  id          String   @id @default(cuid())
  name        String
  alias       String?
  client      String?
  vertical    String?
  fanpage     String[]
  instagram   String[]
  whatsapp    String[]
  webchat     String[] // ID(s) del widget de web chat (Cari/Botmaker/Google)
  website     String?
  persona     String?  @db.Text
  geo         String?
  status      String   @default("Activo") // Activo, Pausado, Draft, Completado
  dateStart   String?
  dateEnd     String?
  workspaceId String
  publicToken String?  @unique // Enlace mágico para acceso de clientes (solo lectura)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace               Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members                 ProjectMember[]
  channels                Channel[]
  briefs                  Brief[]
  alerts                  ProjectAlert[]
  metaSources             MetaSource[]
  waPhoneSources          WaPhoneSource[]
  drafts                  DraftPost[]
  mediaAssets             MediaAsset[]
  alertsEnabled           Boolean                     @default(true)
  alertEmails             String[]
  crmIntegrationId        String? // Legacy: single analytics integration (kept for back-compat)
  crmType                 String? // custom_crm, botmaker, etc.
  /// Tipo de flujo del bot (metodología BAIT) para el Funnel 2 por bot:
  /// prepago | pospago_alineado | pospago_simplificado | google_bait. Vacío = auto.
  botFlowType             String?
  /// CRMs conectados al proyecto (ids de Integration). Un proyecto puede enviar
  /// tráfico a varias herramientas (ej. botmaker + cari) y el análisis de
  /// resultados se segmenta por cada una de forma independiente.
  crmIntegrationIds       String[]                    @default([])
  /// Recursos de Google vinculados a este proyecto (por proyecto, no por workspace).
  /// Estructura: { adsCustomerId, ga4PropertyId, gtmAccountId, gtmContainerId }
  /// Permite que cada proyecto del cliente use sus propias cuentas de Google.
  googleSources           Json?                       @default("{}")
  googleSourceLinks       GoogleSource[]              @relation("ProjectGoogleSources")
  ariaDatasets            AriaDataset[]
  reports                 Report[]
  optimizationClientLinks OptimizationClientProject[]

  @@unique([workspaceId, id])
}

// Cache de resolución para webhooks de Meta: externalId (pageId / igAccountId /
// adAccountId sin prefijo "act_") → projectId. Permite resolver el proyecto de
// un evento con un lookup indexado en lugar de escanear todos los proyectos.
// Se puebla automáticamente la primera vez que un evento se resuelve por scan.
model MetaSource {
  id         String   @id @default(cuid())
  externalId String // pageId | igAccountId | adAccountId (normalizado)
  kind       String // "page" | "instagram" | "ad_account"
  projectId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([externalId, projectId])
  @@index([externalId])
}

// Cache de resolución para webhooks de WhatsApp Cloud API:
// phoneNumberId (Meta) → workspaceId + projectId opcional.
// Se puebla al conectar un número en /api/connect/whatsapp y permite
// resolver el workspace de cada evento entrante en O(1).
model WaPhoneSource {
  id            String   @id @default(cuid())
  phoneNumberId String   @unique // WhatsApp Phone Number ID de Meta
  workspaceId   String
  projectId     String? // proyecto asociado (opcional, si el número es por proyecto)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([phoneNumberId])
}

// Mapas de fuentes de Google hacia los proyectos
model GoogleSource {
  id         String   @id @default(cuid())
  externalId String // ID of the google asset (e.g. ads ID, ga4 property ID)
  kind       String // "google_ads", "ga4_property", "gtm_container"
  projectId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation("ProjectGoogleSources", fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([externalId, projectId])
  @@index([externalId])
}

model ProjectMember {
  id        String @id @default(cuid())
  projectId String
  userId    String
  role      String @default("MEMBER")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Capturista {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Channel {
  id        String @id @default(cuid())
  projectId String
  name      String
  type      String // FACEBOOK, INSTAGRAM, WHATSAPP, etc.
  config    Json?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// OKR (Objectives and Key Results)
// ------------------------------------------------------

model Objective {
  id          String   @id @default(cuid())
  workspaceId String
  areaId      String? // Reference to an area in WorkspaceSettings if applicable, or just a string name
  title       String
  description String?  @db.Text
  quarter     String // e.g., "2026-Q3"
  status      String   @default("active") // active, completed, archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  keyResults KeyResult[]

  @@index([workspaceId])
  @@index([workspaceId, areaId])
}

model KeyResult {
  id           String   @id @default(cuid())
  objectiveId  String
  title        String
  targetValue  Float
  currentValue Float    @default(0)
  unit         String? // e.g. "%", "$", "leads"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([objectiveId])
}

// ------------------------------------------------------
// OPS / TASKS
// ------------------------------------------------------

model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?   @db.Text
  assignee     String? // legacy name field
  assigneeId   String? // robust userId
  priority     String    @default("P2") // P0, P1, P2, P3
  status       String    @default("Backlog") // Backlog, WIP, Review, Done
  startDate    DateTime?
  dueDate      DateTime?
  estimate     Float? // hours or story points
  tags         String[]
  order        Int       @default(0)
  attachments  Json      @default("[]") // [{name, url, type, size, uploadedAt}]
  projectId    String?
  parentId     String?
  createdBy    String? // userId who created the task
  // ── Cross-area request (Capa 3): a task with targetAreaId is a "solicitud" ──
  targetAreaId String? // area the request is routed to (id from WorkspaceSettings.areas)
  requestType  String? // request type label/id within the target area
  requesterId  String? // userId who raised the request
  workspaceId  String
  keyResultId  String?
  briefId      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  closedAt     DateTime? // stamped when status → Done (for auto-SLA)

  // ── Aprobación por líder ────────────────────────────────────────────────
  /// null = sin revisión pendiente | "pending" | "approved" | "rejected"
  approvalState String?
  submittedAt   DateTime? // cuando el ejecutor marcó la tarea como terminada
  submittedById String? // quién la mandó a revisión
  reviewedAt    DateTime?
  reviewedById  String? // líder que aprobó/rechazó
  rejectionNote String?   @db.Text
  reworkCount   Int       @default(0) // cuántas veces fue devuelta

  // ── Estancamiento (quién la tiene detenida) ─────────────────────────────
  /// Último avance real (cambio de estado o de responsable). Base para medir
  /// cuánto lleva detenida y en manos de quién.
  lastProgressAt DateTime @default(now())
  /// Usuario que la tiene detenida en el momento del último avance: el
  /// responsable si está en curso, o el líder si espera aprobación.
  holderId       String?

  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  keyResult  KeyResult?     @relation(fields: [keyResultId], references: [id], onDelete: SetNull)
  brief      Brief?         @relation(fields: [briefId], references: [id], onDelete: SetNull)
  parent     Task?          @relation("SubTasks", fields: [parentId], references: [id], onDelete: Cascade)
  children   Task[]         @relation("SubTasks")
  blockedBy  Task[]         @relation("TaskDependencies")
  blocks     Task[]         @relation("TaskDependencies")
  comments   TaskComment[]
  activities TaskActivity[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([parentId])
  @@index([briefId])
  // Bandeja del líder: tareas esperando aprobación en el workspace.
  @@index([workspaceId, approvalState])
  // Reporte de estancamiento: qué lleva detenido y desde cuándo.
  @@index([workspaceId, lastProgressAt])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  userName  String // denormalized for display
  userImage String? // denormalized avatar
  content   String   @db.Text
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  userName  String
  action    String // "created", "status_changed", "assigned", "priority_changed", "commented", "attachment_added"
  field     String? // which field changed
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ------------------------------------------------------

model Brief {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String?
  title       String
  content     Json     @default("{}")
  status      String   @default("Draft") // Draft, Review, Approved
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tasks     Task[]

  @@index([workspaceId])
  @@index([workspaceId, status])
}

// ------------------------------------------------------
// PUBLISHER / SCHEDULING
// ------------------------------------------------------

model MediaAsset {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  projectId   String?
  url         String
  fileName    String
  mimeType    String
  size        Int
  width       Int?
  height      Int?
  status      String   @default("ready") // uploading, ready, processing_failed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, projectId])
}

model DraftPost {
  id          String  @id @default(cuid())
  workspaceId String
  projectId   String?
  authorId    String?

  // Shared base content
  baseContent   String   @db.Text
  baseMediaUrls String[] // Array of MediaAsset URLs or raw URLs

  // Per-channel overrides (JSON) - e.g. { "instagram": { content: "...", media: [...] } }
  channelOverrides Json @default("{}")

  status      String    @default("draft") // draft, scheduled, publishing, completed, failed
  scheduledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  transmissions Transmission[]

  @@index([workspaceId, status])
  @@index([scheduledAt])
}

model Transmission {
  id          String @id @default(cuid())
  draftId     String
  workspaceId String

  channel     String // "facebook_page", "instagram_ig", "linkedin", "tiktok"
  accountId   String // the external page/account ID
  accountName String? // human readable

  status      String    @default("pending") // pending, active, completed, failed, cancelled
  scheduledAt DateTime?
  publishedAt DateTime?

  // The exact payload that will be sent to the channel
  finalContent   String   @db.Text
  finalMediaUrls String[]

  externalPostId String? // ID returned by the platform
  externalUrl    String? // public URL of the post
  errorMessage   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  draft     DraftPost    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  jobs      PublishJob[]

  @@index([draftId])
  @@index([workspaceId, status])
  @@index([scheduledAt])
}

model PublishJob {
  id             String @id @default(cuid())
  transmissionId String

  step          String // e.g. "upload_media", "create_container", "publish", "verify"
  status        String    @default("pending") // pending, running, success, failed, retry
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  nextAttemptAt DateTime?

  payload Json? // Context for this specific step
  result  Json? // API response or error details

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transmission Transmission @relation(fields: [transmissionId], references: [id], onDelete: Cascade)

  @@index([transmissionId])
  @@index([status, nextAttemptAt])
}

// ------------------------------------------------------
// AUDIT LOGS
// ------------------------------------------------------

model AuditLog {
  id           String   @id @default(cuid())
  workspaceId  String
  userId       String?
  action       String // e.g., "connect_integration", "delete_draft", "update_settings"
  resourceType String // e.g., "Integration", "DraftPost", "WorkspaceSettings"
  resourceId   String?
  details      Json? // DO NOT store tokens here.
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, action])
  @@index([workspaceId, createdAt])
}

// ------------------------------------------------------
// LEGACY PUBLISHER (ScheduledPost)
// ------------------------------------------------------

model ScheduledPost {
  id                String    @id @default(cuid())
  workspaceId       String
  projectId         String?
  userId            String? // who created this post
  channels          String[] // ["facebook", "instagram", "tiktok", "linkedin"]
  content           String    @db.Text
  contentByPlatform Json? // { "facebook": "...", "instagram": "..." }
  firstComment      String?   @db.Text // Auto-posted as first comment on IG after publish
  mediaUrls         String[] // multiple media files
  mediaUrl          String? // legacy single media (kept for compat)
  type              String    @default("post") // post, reel, story, carousel
  hashtags          String[]
  scheduledAt       DateTime?
  publishedAt       DateTime?
  status            String    @default("Draft") // Draft, Scheduled, Published, Failed
  // Flujo de aprobación de equipo (opt-in por workspace). null = no requiere aprobación;
  // "pending" = espera revisión; "approved"/"rejected" = revisado. Un post "pending" no
  // puede programarse ni publicarse hasta ser aprobado por OWNER/ADMIN.
  approvalStatus    String? // null | pending | approved | rejected
  approvedById      String? // userId del revisor
  approvedAt        DateTime?
  reviewNote        String?   @db.Text // comentario del revisor (p. ej. motivo de rechazo)
  error             String?   @db.Text // error message if publish failed
  externalIds       Json? // { facebook: "post_id", instagram: "media_id" }
  qStashMessageId   String? // ID del mensaje programado en QStash
  pageName          String? // Facebook page name used
  pageId            String? // Facebook page ID used
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([scheduledAt])
  @@index([qStashMessageId]) // for O(1) QStash job cancellation lookups
}

// ------------------------------------------------------
// INTEGRATIONS
// ------------------------------------------------------

model Integration {
  id          String    @id @default(cuid())
  workspaceId String
  provider    String // "meta_ads", "meta_community", "google", etc.
  /// "workspace" → workspace-level integration (OWNER/ADMIN shared, e.g. meta_ads, google)
  /// userId     → user-level integration (each member connects their own account independently)
  userId      String?   @default("workspace")
  name        String? // User-defined name for the integration
  credentials Json // Encrypted with AES-256 (encryptToken/decryptToken)
  config      Json?     @default("{}") // Analytics settings (syncFrequency, paused, backfill, etc)
  connected   Boolean   @default(false)
  connectedAt DateTime?
  connectedBy String? // userId of who first connected this integration
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedUser User?     @relation("UserIntegrations", fields: [connectedBy], references: [id], onDelete: SetNull)

  // Unique per (workspace, provider, userId):
  //   - Workspace-shared: userId="workspace" → only one per workspace+provider
  //   - User-level: userId=actualUserId → one per user per workspace+provider
  @@unique([workspaceId, provider, userId])
  @@index([workspaceId, userId])
  @@index([workspaceId, provider])
}

// ------------------------------------------------------
// NOTIFICATIONS
// ------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // task_assigned, sla_warning, sla_expired, status_changed, mention
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
}

// ------------------------------------------------------
// PROJECT ALERTS
// ------------------------------------------------------

model ProjectAlert {
  id        String   @id @default(cuid())
  projectId String
  type      String // health_score, cpr_spike, frequency_high, budget_pace, ctr_drop
  severity  String // critical, warning, info
  title     String
  message   String   @db.Text
  emailSent Boolean  @default(false)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
}

// ------------------------------------------------------
// INBOX 2.0
// ------------------------------------------------------

model InboxConversation {
  id            String    @id @default(cuid())
  workspaceId   String
  platform      String // "facebook_messenger", "instagram_dm", "instagram_comment"
  externalId    String // Conversation ID from Meta
  pageId        String? // Facebook Page ID or IG user ID
  igId          String? // Legacy Instagram user ID (kept for backwards compat)
  contactName   String?
  contactAvatar String?
  // CRM: enlace a la persona unificada entre canales (auto-poblado en el inbox-store).
  contactId     String?
  lastMessage   String?
  lastMessageAt DateTime?
  unread        Boolean   @default(true)
  priority      Boolean   @default(false)
  assignedTo    String? // userId
  status        String    @default("open") // "open", "closed", "assigned"
  tags          String[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages  InboxMessage[]
  notes     InboxNote[]

  @@unique([workspaceId, externalId])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([contactId])
}

// ------------------------------------------------------
// CRM — Contacto unificado (omnicanal)
// ------------------------------------------------------
// Una persona = un Contact por workspace, con N identidades por canal
// (ContactChannel). Permite historial unificado, tags/campos a nivel persona,
// asignación de propietario y etapa de ciclo de vida (lead → cliente).
model Contact {
  id              String    @id @default(cuid())
  workspaceId     String
  name            String?
  email           String?
  phone           String?
  avatar          String?
  company         String?
  /// lead | prospect | customer | evangelist | other
  lifecycleStage  String    @default("lead")
  ownerId         String? // userId responsable de la cuenta
  tags            String[]
  customFields    Json      @default("{}")
  notes           String?   @db.Text
  lastContactedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channels      ContactChannel[]
  conversations InboxConversation[]

  @@index([workspaceId])
  @@index([workspaceId, lifecycleStage])
  @@index([workspaceId, ownerId])
}

// Identidad de un contacto en un canal concreto (PSID / teléfono / IG id).
// El @@unique permite resolver O(1) externalId→contacto y unificar canales.
model ContactChannel {
  id          String   @id @default(cuid())
  contactId   String
  workspaceId String
  platform    String // whatsapp | facebook_messenger | instagram_dm | facebook_comment | instagram_comment
  externalId  String // PSID / phone (sin prefijo) / IG-scoped id
  handle      String? // nombre/handle visible en ese canal
  createdAt   DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform, externalId])
  @@index([contactId])
  @@index([workspaceId])
}

model InboxMessage {
  id             String    @id @default(cuid())
  conversationId String
  externalId     String?
  content        String    @db.Text
  sender         String // "user" | "page"
  senderName     String?
  senderAvatar   String?
  attachments    Json?
  reaction       String?
  deliveredAt    DateTime? // cuando Meta confirma entrega (msg.delivery watermark)
  readAt         DateTime? // cuando el usuario lee (msg.read watermark)
  replyToId      String? // mid del mensaje al que se responde (Messenger reply-to)
  editedAt       DateTime? // timestamp de última edición (message_edits webhook)
  isEdited       Boolean   @default(false)
  createdAt      DateTime  @default(now())

  conversation InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, externalId])
  @@index([conversationId])
}

model SavedReply {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  content     String   @db.Text
  shortcut    String? // e.g., "/gracias"
  createdAt   DateTime @default(now())

  @@index([workspaceId])
}

model InboxNote {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  content        String   @db.Text
  createdAt      DateTime @default(now())

  conversation InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model DmAutomationRule {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  trigger     String // keyword that activates the rule
  response    String   @db.Text // auto-reply message
  platforms   String[] // ["messenger", "instagram_dm"]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, active])
}

model TrackedKeyword {
  id          String    @id @default(cuid())
  workspaceId String
  query       String
  type        String // "keyword" | "hashtag" | "competitor"
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, query])
  @@index([workspaceId])
}

// ------------------------------------------------------
// SOCIAL LISTENING
// ------------------------------------------------------

model ListeningQuery {
  id          String   @id @default(cuid())
  workspaceId String
  query       String // keyword or hashtag
  type        String // "keyword", "hashtag", "competitor"
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  mentions ListeningMention[]

  @@index([workspaceId])
}

model ListeningMention {
  id           String   @id @default(cuid())
  queryId      String
  platform     String
  content      String   @db.Text
  author       String?
  authorAvatar String?
  sentiment    String? // "positive", "negative", "neutral"
  url          String?
  publishedAt  DateTime
  createdAt    DateTime @default(now())

  query ListeningQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@index([queryId])
  @@index([publishedAt])
}

// ------------------------------------------------------
// STREAMS (Real-time monitoring)
// ------------------------------------------------------

model StreamBoard {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns   StreamColumn[]

  @@index([workspaceId])
}

model StreamColumn {
  id        String   @id @default(cuid())
  boardId   String
  type      String // "home_feed", "mentions", "keyword", "hashtag", "scheduled", "published"
  platform  String // "facebook", "instagram", "tiktok", "linkedin", "x"
  query     String? // keyword or hashtag for tracking
  position  Int      @default(0)
  createdAt DateTime @default(now())

  board StreamBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
}

// ------------------------------------------------------
// META DATA DELETION REQUESTS (GDPR compliance)
// ------------------------------------------------------
// Tracks user data deletion requests received via Meta's
// Data Deletion Callback. Each request must be acknowledged
// and the data deleted asynchronously.

model DataDeletionRequest {
  id               String    @id @default(cuid())
  confirmationCode String    @unique @default(cuid())
  metaUserId       String // Facebook user_id from signed_request
  status           String    @default("pending") // pending | processing | completed | failed
  requestedAt      DateTime  @default(now())
  completedAt      DateTime?

  @@index([metaUserId])
  @@index([status])
}

// ------------------------------------------------------
// ADS MANAGER CACHE
// ------------------------------------------------------
model MetaAdsCache {
  id          String   @id @default(cuid())
  // Aislamiento multi-tenant: la caché DEBE estar scopeada por workspace. Sin esto,
  // un workspace podía servir datos de gasto cacheados de una cuenta publicitaria de
  // OTRO workspace con solo conocer su adAccountId. Default "" para que `db push` añada
  // la columna sin pérdida de datos; las filas legacy ("") nunca se sirven (las lecturas
  // filtran siempre por un workspaceId real) y se regeneran.
  workspaceId String   @default("")
  adAccountId String // ID de la cuenta publicitaria
  level       String // "campaigns", "adsets", "ads"
  dateRange   String // Clave del rango de fechas (ej. "last_7d", "maximum", "2026-06-01_2026-06-12")
  data        Json // El payload JSON completo y ya procesado
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, adAccountId, level, dateRange])
  @@index([workspaceId, adAccountId])
}

// ------------------------------------------------------
// GOOGLE ADS CACHE
// ------------------------------------------------------
model GoogleAdsCache {
  id          String   @id @default(cuid())
  workspaceId String   @default("")
  customerId  String // ID de la cuenta de cliente de Google Ads
  level       String // "campaigns", "adGroups", "ads"
  dateRange   String // Clave del rango de fechas (ej. "last_30d")
  data        Json // El payload JSON completo y ya procesado
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, customerId, level, dateRange])
  @@index([workspaceId])
  @@index([customerId])
}

// ------------------------------------------------------
// ANALYTICS CACHE
// ------------------------------------------------------
model MetaAnalyticsCache {
  id          String   @id @default(cuid())
  workspaceId String
  endpoint    String // "organic", "audience", "posts", "best-time", "stories", "reels", "growth"
  paramsKey   String // hash o clave de los parámetros de consulta (ej. "days=30&pageIds=...&platform=...")
  data        Json // El payload JSON completo y ya procesado
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, endpoint, paramsKey])
  @@index([workspaceId])
}

// ------------------------------------------------------
// CONVERSATIONAL ANALYTICS MODULE (PHASE 1)
// ------------------------------------------------------

model SyncJob {
  id              String    @id @default(cuid())
  workspaceId     String
  projectId       String?
  clientId        String?
  channelConfigId String?
  integrationId   String
  provider        String
  reportType      String
  status          String // pending, running, completed, failed
  startDate       DateTime
  endDate         DateTime
  recordsInserted Int       @default(0)
  errorMessage    String?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?

  @@index([workspaceId, provider])
  @@index([workspaceId, projectId])
}

model RawProviderEvent {
  id              String   @id @default(cuid())
  workspaceId     String
  projectId       String?
  clientId        String?
  channelConfigId String?
  provider        String
  externalId      String
  payload         Json
  createdAt       DateTime @default(now())

  @@index([workspaceId, provider])
  @@index([workspaceId, projectId])
}

model NormalizedConversation {
  id                     String  @id @default(cuid())
  workspaceId            String
  projectId              String?
  clientId               String?
  channelConfigId        String?
  provider               String
  providerConversationId String  @unique
  channel                String
  botId                  String?
  customerId             String?
  customerIdentifierHash String?

  conversationStartedAt DateTime
  conversationEndedAt   DateTime?
  firstBotResponseAt    DateTime?
  firstAgentResponseAt  DateTime?
  closedAt              DateTime?

  status     String // active, closed, transferred, abandoned
  outcome    String? // resolved, transferred, abandoned, error
  resolvedBy String? // bot, agent, mixed

  wasBotOnly Boolean @default(false)
  wasHandoff Boolean @default(false)
  queueId    String?
  agentId    String?

  botName   String?
  agentName String?
  queueName String?
  skillName String?

  totalUserMessages  Int @default(0)
  totalBotMessages   Int @default(0)
  totalAgentMessages Int @default(0)
  totalFallbacks     Int @default(0)

  csatScore  Float?
  npsScore   Float?
  campaignId String?
  serviceId  String?
  tags       String[] @default([])

  // Clasificación auditable: qué regla determinó el outcome y si requiere revisión humana
  appliedRuleId  String?
  requiresReview Boolean @default(false)

  durationSeconds          Int?
  waitingTimeSeconds       Int?
  firstResponseTimeSeconds Int?
  handleTimeSeconds        Int?

  syncedAt DateTime @default(now())

  @@index([workspaceId, conversationStartedAt])
  @@index([workspaceId, provider, providerConversationId])
  @@index([workspaceId, agentId])
  @@index([workspaceId, campaignId])
  @@index([workspaceId, projectId])
}

model NormalizedMessage {
  id                String   @id @default(cuid())
  workspaceId       String
  projectId         String?
  clientId          String?
  channelConfigId   String?
  provider          String
  providerMessageId String   @unique
  conversationId    String
  senderType        String // user, bot, agent, system
  messageType       String // text, image, template
  messageTextHash   String?
  intent            String?
  topic             String?
  confidence        Float?
  isFallback        Boolean  @default(false)
  isError           Boolean  @default(false)
  isTemplate        Boolean  @default(false)
  templateName      String?
  campaignId        String?
  status            String? // sent, delivered, read, replied, failed
  sentAt            DateTime

  @@index([workspaceId, conversationId])
  @@index([workspaceId, projectId])
}

model AnalyticsOutcomeRule {
  id                String   @id @default(cuid())
  workspaceId       String
  projectId         String?
  clientId          String?
  channelConfigId   String?
  name              String
  description       String?
  priority          Int      @default(100) // menor = mayor prioridad; se evalúan en orden ascendente
  enabled           Boolean  @default(true)
  conditions        Json // [{ field, operator, value }]  (AND lógico)
  outcome           String
  resolvedBy        String
  actions           Json? // { requiresReview?: bool, tag?: string }
  appliesToProvider String? // null = todos los proveedores
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([workspaceId, priority])
  @@index([workspaceId, projectId])
}

// Metas y semáforos configurables por workspace (spec §12, §35)
model AnalyticsKpiTarget {
  id                String   @id @default(cuid())
  workspaceId       String
  projectId         String?
  clientId          String?
  channelConfigId   String?
  kpiKey            String
  period            String? // e.g. "2026-07". null = global/default target
  targetValue       Float?
  warningThreshold  Float?
  criticalThreshold Float?
  direction         String   @default("higher_is_better") // higher_is_better | lower_is_better | neutral
  enabled           Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Modificado: Se incluye 'period' (que puede ser null para metas globales)
  @@unique([workspaceId, kpiKey, projectId, period])
  @@index([workspaceId])
  @@index([workspaceId, projectId])
  @@index([period])
}

// Bitácora de auditoría (exportaciones, acceso a datos sensibles, cambios de config)
model AnalyticsAuditLog {
  id              String   @id @default(cuid())
  workspaceId     String
  projectId       String?
  clientId        String?
  channelConfigId String?
  userId          String?
  action          String // export, view_sensitive, rule_create, rule_delete, sync_manual, integration_update
  resourceType    String?
  resourceId      String?
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, projectId])
}

// Agregados diarios precalculados (spec §33)
model AnalyticsDailyMetric {
  id              String   @id @default(cuid())
  workspaceId     String
  projectId       String?
  clientId        String?
  channelConfigId String?
  date            DateTime
  provider        String
  botId           String?
  channel         String?
  metricKey       String
  metricValue     Float
  numerator       Float?
  denominator     Float?
  dimensions      Json?
  calculatedAt    DateTime @default(now())

  // Ojo: Si vamos a soportar métricas diarias por proyecto, el UNIQUE index
  // original colisionaría si hay dos proyectos distintos. Por ahora lo
  // dejamos sin projectId o lo reemplazamos. Para no romper compatibilidad
  // global, mantenemos el UNIQUE sin projectId y si agregamos projectId
  // se volvería complicado, a menos que quitemos el UNIQUE. 
  // Voy a actualizar el UNIQUE para incluir projectId si es necesario en otro paso, 
  // pero el user dijo "forma aditiva"
  // Así que añado projectId al final para no romper nada, y si está nulo funciona global.
  @@unique([workspaceId, projectId, date, provider, botId, channel, metricKey])
  @@index([workspaceId, date])
  @@index([workspaceId, projectId])
}

// Issues de calidad de datos detectados sobre el dataset normalizado (spec §27)
model DataQualityIssue {
  id              String   @id @default(cuid())
  workspaceId     String
  projectId       String?
  clientId        String?
  channelConfigId String?
  provider        String?
  conversationId  String?
  issueType       String // missing_start_date, missing_external_id, negative_duration, frt_gt_duration, unclassified_outcome, ...
  severity        String   @default("warning") // info | warning | critical
  details         String?
  resolved        Boolean  @default(false)
  detectedAt      DateTime @default(now())

  @@index([workspaceId, issueType])
  @@index([workspaceId, projectId])
}

// ------------------------------------------------------
// FUNNELS Y ALERTAS
// ------------------------------------------------------

model AnalyticsFunnel {
  id          String                @id @default(cuid())
  workspaceId String
  projectId   String?
  name        String
  description String?
  provider    String?
  channel     String?
  botId       String?
  steps       AnalyticsFunnelStep[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, projectId])
}

model AnalyticsFunnelStep {
  id             String          @id @default(cuid())
  funnelId       String
  name           String
  orderIndex     Int
  conditionType  String // intent | event | message_text | tag | status
  conditionValue String
  funnel         AnalyticsFunnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@unique([funnelId, orderIndex])
  @@index([funnelId])
}

model AnalyticsAlert {
  id             String   @id @default(cuid())
  workspaceId    String
  projectId      String?
  type           String // csat_low | fallback_high | frt_high | sync_failed | data_quality_critical
  severity       String // warning | critical
  title          String
  message        String
  metricValue    Float?
  thresholdValue Float?
  resolved       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([workspaceId, type])
  @@index([workspaceId, projectId])
  @@index([workspaceId, resolved])
}

// ------------------------------------------------------
// INTEGRATION ASSETS CACHE
// ------------------------------------------------------
model IntegrationAssetCache {
  id            String   @id @default(cuid())
  integrationId String
  workspaceId   String
  provider      String // "meta", "google", "botmaker"
  assetType     String // "ad_account", "bot", "page", "ig_account"
  externalId    String // ID de la cuenta en la plataforma origen
  name          String
  metadata      Json // Estructura variable (roles, spend, tokens)
  syncedAt      DateTime @default(now())

  @@unique([integrationId, assetType, externalId])
  @@index([workspaceId, assetType])
}

// Vistas guardadas del dashboard de Análisis de Resultados: una combinación de
// filtros (FilterState) reutilizable. userId = null → vista compartida del
// workspace; con userId → privada del usuario.
model AnalyticsSavedView {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String?
  userId      String?
  name        String
  filters     Json
  createdAt   DateTime @default(now())

  @@index([workspaceId, projectId])
}

// ------------------------------------------------------
// PORTABILIDAD / CAMBIO DE COMPAÑÍA (Bot Analytics)
// ------------------------------------------------------

/// Representa una solicitud comercial de cambio de compañía / portabilidad.
model BotmakerLeadRequest {
  id          String  @id @default(cuid())
  requestId   String  @unique @default(cuid())
  sessionId   String
  customerId  String?
  botId       String?
  channelId   String?
  platform    String?
  workspaceId String

  /// whatsapp | messenger | comment | webchat | unknown
  sourceKind  String @default("unknown")
  /// prepago | pospago | unknown
  productType String @default("unknown")

  /// started | collecting_data | ocr_pending | ocr_success | ocr_failed |
  /// data_confirmed | sent_to_intelix | intelix_accepted | intelix_rejected |
  /// zapier_sent | zapier_failed | ads_attributed | abandoned | stuck
  leadStatus String @default("started")

  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  abandonedAt    DateTime?
  lastStepAt     DateTime?
  lastStepName   String?
  lastIntentName String?
  lastFlowState  String?

  errorSource  String?
  errorCode    String?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fieldSnapshots     BotmakerLeadFieldSnapshot[]
  ocrExtractions     BotmakerOcrExtraction[]
  intelixSubmissions IntelixSubmission[]
  zapierEvents       ZapierConversionEvent[]

  @@index([workspaceId, leadStatus])
  @@index([workspaceId, sessionId])
  @@index([workspaceId, customerId])
  @@index([workspaceId, botId])
  @@index([workspaceId, channelId])
  @@index([workspaceId, productType])
  @@index([workspaceId, createdAt])
}

/// Guarda campos capturados y sus alias para cada solicitud.
model BotmakerLeadFieldSnapshot {
  id            String  @id @default(cuid())
  leadRequestId String
  sessionId     String?
  customerId    String?

  /// Nombre canónico del campo:
  /// name | last_name | full_name | phone_to_change | nip | nip_expiration_date
  /// birth_date | birth_state | email | ocr_image_url | ga_cid | ig_post_id
  /// from_name | zapier_status | zapier_response | flow_state | raw_nip_detected
  canonicalField     String
  sourceVariableName String?
  rawValue           String?   @db.Text
  maskedValue        String?
  normalizedValue    String?
  isPresent          Boolean   @default(false)
  isValid            Boolean   @default(false)
  validationError    String?
  capturedAt         DateTime?
  messageId          String?
  rawPayload         Json?

  leadRequest BotmakerLeadRequest @relation(fields: [leadRequestId], references: [id], onDelete: Cascade)

  @@index([leadRequestId])
  @@index([leadRequestId, canonicalField])
  @@index([sessionId])
}

/// Guarda trazabilidad de extracciones OCR.
model BotmakerOcrExtraction {
  id            String  @id @default(cuid())
  leadRequestId String
  sessionId     String?
  customerId    String?

  ocrImageUrl                String? @db.Text
  detectedRawText            String? @db.Text
  detectedNipRaw             String?
  extractedNip               String?
  extractedNipExpirationDate String?

  /// pending | success | partial | failed
  extractionStatus String    @default("pending")
  extractionError  String?
  codeActionName   String?
  executedAt       DateTime?
  rawPayload       Json?

  leadRequest BotmakerLeadRequest @relation(fields: [leadRequestId], references: [id], onDelete: Cascade)

  @@index([leadRequestId])
  @@index([sessionId])
  @@index([extractionStatus])
}

/// Guarda cada intento de envío a Intelix (CRM de portabilidad).
model IntelixSubmission {
  id            String  @id @default(cuid())
  leadRequestId String
  sessionId     String?
  customerId    String?

  /// prepago | pospago | unknown
  productType     String    @default("unknown")
  submittedAt     DateTime?
  requestPayload  Json?
  responsePayload Json?

  /// accepted | rejected | error | timeout | unknown
  status                 String  @default("unknown")
  crmAcceptanceCondition String?
  intelixFolio           String?
  intelixErrorCode       String?
  intelixErrorMessage    String?
  latencyMs              Int?
  retryCount             Int     @default(0)

  createdAt DateTime @default(now())

  leadRequest BotmakerLeadRequest @relation(fields: [leadRequestId], references: [id], onDelete: Cascade)

  @@index([leadRequestId])
  @@index([sessionId])
  @@index([status])
  @@index([createdAt])
}

/// Guarda trazabilidad de eventos Zapier y atribución Ads.
model ZapierConversionEvent {
  id            String  @id @default(cuid())
  leadRequestId String
  sessionId     String?
  customerId    String?

  /// meta_ads | google_ads | zapier | unknown
  platformTarget String  @default("unknown")
  zapierStatus   String?
  zapierResponse String? @db.Text

  gaCid    String?
  gclid    String?
  fbclid   String?
  fbc      String?
  fbp      String?
  igPostId String?
  fromName String?

  sentAt     DateTime?
  responseAt DateTime?

  /// sent | success | failed | pending | unknown
  status       String  @default("unknown")
  errorMessage String?
  rawPayload   Json?
  rawResponse  Json?

  createdAt DateTime @default(now())

  leadRequest BotmakerLeadRequest @relation(fields: [leadRequestId], references: [id], onDelete: Cascade)

  @@index([leadRequestId])
  @@index([sessionId])
  @@index([status])
  @@index([igPostId])
  @@index([gaCid])
}

// ------------------------------------------------------
// BOT ANALYTICS (PHASE 2 - COMMERCIAL & OPERATIONAL)
//
// Live ingestion runs through app/api/botmaker/webhook -> BotmakerLeadRequest
// (+ IntelixSubmission / ZapierConversionEvent / BotmakerLeadFieldSnapshot /
// BotmakerOcrExtraction), read by app/api/botmaker/analytics/portability/*.
// The earlier PortabilityRequest/BotAnalyticsEvent/BotmakerVariableAlias models
// were a superseded v1 path (no reader, no caller) and were removed.
// ------------------------------------------------------

// ------------------------------------------------------
// ARIA PREDICTIVE AI (CRECIMIENTO)
// ------------------------------------------------------

model AriaDataset {
  id           String   @id @default(cuid())
  workspaceId  String
  projectId    String?
  clientName   String?
  verticalName String?
  targetType   String   @default("PROJECT") // "PROJECT", "CLIENT", "VERTICAL"
  name         String
  source       String // e.g. "csv", "google_sheets", "hubspot", "auto"
  status       String   @default("uploaded") // uploaded, processing, ready, awaiting_data, baseline, error
  rowCount     Int      @default(0)
  // Ingesta robusta: fuente cruda en Vercel Blob + metadatos de parsing detectados.
  rawFileUrl   String?
  delimiter    String? // delimitador detectado (",", ";", "\t")
  encoding     String? // "utf-8" | "windows-1252"
  columnCount  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  columns   AriaDatasetColumn[]
  rows      AriaDatasetRow[]
  models    AriaModel[]

  // Idempotencia del flujo auto: un único dataset CLIENT/VERTICAL/PROJECT por scope.
  // (En Postgres los NULL son distintos, así que filas PROJECT con client/vertical
  //  nulos no colisionan entre sí — la dedup aplica solo cuando el campo está seteado.)
  @@unique([workspaceId, targetType, clientName], name: "aria_scope_client")
  @@unique([workspaceId, targetType, verticalName], name: "aria_scope_vertical")
  @@unique([workspaceId, targetType, projectId], name: "aria_scope_project")
  @@index([workspaceId])
  @@index([projectId])
  @@index([clientName])
  @@index([verticalName])
}

// Substrato de entrenamiento: una fila persistida por registro del dataset.
// `data` es el mapa columna→valor (string crudo); el motor lo transforma a features.
model AriaDatasetRow {
  id        String   @id @default(cuid())
  datasetId String
  rowIndex  Int
  data      Json
  createdAt DateTime @default(now())

  dataset AriaDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, rowIndex])
  @@index([datasetId])
}

model AriaDatasetColumn {
  id            String  @id @default(cuid())
  datasetId     String
  name          String
  dataType      String // "string", "number", "boolean", "date"
  nullCount     Int     @default(0)
  isTarget      Boolean @default(false)
  isFeature     Boolean @default(true)
  // Perfilado determinista del Data Hub (poblado en la ingesta).
  distinctCount Int?
  minValue      Float?
  maxValue      Float?
  meanValue     Float?
  sampleValues  Json?

  dataset AriaDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
}

model AriaModel {
  id        String   @id @default(cuid())
  datasetId String
  name      String
  algorithm String // e.g. "logistic_regression", "scorecard_woe", "heuristic_baseline"
  status    String   @default("training") // training, ready, baseline, failed
  accuracy  Float?
  precision Float?
  recall    Float?
  auc       Float?
  baseRate  Float? // tasa base de conversión del set de entrenamiento
  params    Json? // artefacto entrenado: pesos, bias, encoders, normalización, umbrales
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dataset     AriaDataset      @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  runs        AriaModelRun[]
  predictions AriaPrediction[]

  @@index([datasetId])
}

model AriaModelRun {
  id        String   @id @default(cuid())
  modelId   String
  status    String // running, success, failed
  metrics   Json? // detailed metrics/logs
  createdAt DateTime @default(now())

  model AriaModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
}

model AriaPrediction {
  id          String   @id @default(cuid())
  modelId     String
  recordId    String // identifier for the row/lead
  score       Float // 0 to 100
  probability Float // 0.0 to 1.0
  priority    String // "High", "Medium", "Low"
  insights    Json? // factors influencing the score
  createdAt   DateTime @default(now())

  model AriaModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
}

// ------------------------------------------------------
// CENTURION (Marketing Mix Modeling)
// ------------------------------------------------------
model CenturionModel {
  id           String    @id @default(cuid())
  workspaceId  String
  clientName   String
  verticalName String?
  engine       String    @default("FastMMM") // "FastMMM" o "BayesMMM"
  config       Json // Guarda canales, rows, coeficientes y NRMSE
  metrics      Json? // NRMSE, R2, wMAPE
  lastIngestAt DateTime? // Última ingesta automática exitosa
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Único por (workspace, cliente): todo el código lo trata así (findFirst/deleteMany
  // por esas dos columnas). El índice simple permitía duplicados bajo carrera find→create.
  @@unique([workspaceId, clientName])
}

// ------------------------------------------------------
// MMM — Spend semanal pre-ingestado (auto-sync)
// ------------------------------------------------------
// Cada registro es el spend de UN canal en UNA semana ISO para UN cliente.
// Poblado automáticamente por el cron /api/cron/mmm-ingest.
// El endpoint /api/mmm/spend lee de aquí en vez de llamar a Graph API on-demand.
model MmmWeeklySpend {
  id          String   @id @default(cuid())
  workspaceId String
  clientName  String // Project.client scope
  week        String // ISO week: "2026-W26"
  channel     String // "meta" | "google" | "tiktok" | etc.
  spend       Float // Spend en moneda de la cuenta
  outcome     Float? // Conversión auto-importada (purchases/leads value)
  source      String   @default("auto") // "auto" | "manual"
  syncedAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, clientName, week, channel])
  @@index([workspaceId, clientName])
}

// ------------------------------------------------------
// OPTIMIZATION CENTER — PHASE 1 (read-only foundations)
// ------------------------------------------------------

/// Stable client identity for optimization. Project.client remains a legacy
/// display field; analytical data must use this id instead of a mutable name.
model OptimizationClient {
  id              String   @id @default(cuid())
  workspaceId     String
  key             String
  displayName     String
  status          String   @default("active") // active | paused | archived
  environment     String   @default("production") // production | test | demo | legacy
  defaultCurrency String
  timezone        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace   Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects    OptimizationClientProject[]
  adAccounts  OptimizationAdAccount[]
  objectives  OptimizationObjective[]
  snapshots   OptimizationSnapshot[]
  results     OptimizationAnalysisResult[]
  actions     OptimizationProposedAction[]
  evaluations OptimizationEvaluation[]
  approvals   OptimizationActionApproval[]
  executions  OptimizationActionExecution[]
  auditEvents OptimizationAuditEvent[]

  @@unique([workspaceId, key])
  @@unique([workspaceId, id])
  @@index([workspaceId, environment, status])
}

/// A project can belong to only one optimization client. workspaceId is kept
/// explicitly so every lookup can include the tenant boundary.
model OptimizationClientProject {
  id          String   @id @default(cuid())
  workspaceId String
  clientId    String
  projectId   String   @unique
  createdAt   DateTime @default(now())

  client  OptimizationClient @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Cascade)
  project Project            @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, clientId, projectId])
  @@index([workspaceId, clientId])
}

/// Explicit allow-list of advertising accounts available to one client.
model OptimizationAdAccount {
  id                String   @id @default(cuid())
  workspaceId       String
  clientId          String
  provider          String
  externalAccountId String
  displayName       String?
  currency          String
  timezone          String
  attributionWindow String
  authorized        Boolean  @default(false)
  configuration     Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  client OptimizationClient @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([clientId, provider, externalAccountId])
  @@index([workspaceId, clientId, authorized])
}

/// Versioned quantitative goal. The service activates at most one objective
/// per client and records the transition in the optimization audit ledger.
model OptimizationObjective {
  id                   String    @id @default(cuid())
  workspaceId          String
  clientId             String
  version              Int
  status               String    @default("draft") // draft | active | retired
  primaryKpi           String
  direction            String
  targetValue          Float
  windowType           String
  windowStart          DateTime?
  windowEnd            DateTime?
  currency             String
  timezone             String
  hardConstraints      Json
  softPreferences      Json
  guardrails           Json
  riskTolerance        String
  maxChangePctPerCycle Float
  approvalPolicy       Json
  effectiveFrom        DateTime?
  effectiveTo          DateTime?
  createdById          String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    OptimizationClient @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([clientId, version])
  @@index([workspaceId, clientId, status])
}

/// Immutable analytical input. There are intentionally no update/delete APIs.
model OptimizationSnapshot {
  id                   String   @id @default(cuid())
  workspaceId          String
  clientId             String
  schemaVersion        String
  contentHash          String
  periodStart          DateTime
  periodEnd            DateTime
  cutoffAt             DateTime
  currency             String
  timezone             String
  authorizedAdAccounts Json
  sources              Json
  freshness            Json
  normalizedMetrics    Json
  activeObjective      Json
  dataQuality          Json
  modelVersions        Json
  configuration        Json
  status               String // valid | degraded | invalid
  createdById          String?
  createdAt            DateTime @default(now())

  workspace          Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client             OptimizationClient           @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Cascade)
  results            OptimizationAnalysisResult[]
  actions            OptimizationProposedAction[]
  sourceEvaluations  OptimizationEvaluation[]     @relation("EvaluationSourceSnapshot")
  outcomeEvaluations OptimizationEvaluation[]     @relation("EvaluationOutcomeSnapshot")
  auditEvents        OptimizationAuditEvent[]

  @@unique([workspaceId, clientId, contentHash])
  @@unique([workspaceId, clientId, id])
  @@index([workspaceId, clientId, cutoffAt])
}

/// Immutable structured output from a quantitative or contextual service.
model OptimizationAnalysisResult {
  id                       String   @id @default(cuid())
  workspaceId              String
  clientId                 String
  snapshotId               String
  analysisType             String
  observations             Json
  inferences               Json
  predictions              Json
  candidateRecommendations Json
  evidence                 Json
  confidence               Json
  limitations              Json
  model                    Json
  status                   String
  createdAt                DateTime @default(now())

  workspace   Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client      OptimizationClient       @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Cascade)
  snapshot    OptimizationSnapshot     @relation(fields: [workspaceId, clientId, snapshotId], references: [workspaceId, clientId, id], onDelete: Cascade)
  evaluations OptimizationEvaluation[]

  @@index([workspaceId, clientId, createdAt])
  @@index([snapshotId, analysisType])
}

/// Persisted proposal. Phase 4 only executes explicitly approved, reversible
/// actions after a fresh remote preflight.
model OptimizationProposedAction {
  id                     String   @id @default(cuid())
  workspaceId            String
  clientId               String
  snapshotId             String
  provider               String
  accountId              String
  campaignId             String?
  entity                 Json
  field                  String
  currentValue           Json
  proposedValue          Json
  unit                   String
  currency               String?
  expectedImpact         Json
  uncertaintyInterval    Json
  risk                   String
  evidence               Json
  rollbackCondition      Json
  idempotencyKey         String   @unique
  remoteStateFingerprint String
  expiresAt              DateTime
  requiredApproverRole   String
  state                  String   @default("draft") // draft | requires_review | approved | rejected | blocked | executing | executed | rollback_pending | rolled_back | expired
  createdById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  workspace   Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client      OptimizationClient            @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Cascade)
  snapshot    OptimizationSnapshot          @relation(fields: [workspaceId, clientId, snapshotId], references: [workspaceId, clientId, id], onDelete: Cascade)
  evaluations OptimizationEvaluation[]
  approvals   OptimizationActionApproval[]
  executions  OptimizationActionExecution[]
  auditEvents OptimizationAuditEvent[]

  @@unique([workspaceId, clientId, id])
  @@index([workspaceId, clientId, state])
  @@index([snapshotId])
}

/// Append-only human decisions bound to a fingerprint of the proposed action.
/// The latest decision per approver is used when evaluating the policy.
model OptimizationActionApproval {
  id                String   @id @default(cuid())
  workspaceId       String
  clientId          String
  actionId          String
  approverId        String
  approverRole      String
  decision          String // approved | rejected
  comment           String?
  actionFingerprint String
  createdAt         DateTime @default(now())

  workspace Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    OptimizationClient         @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Cascade)
  action    OptimizationProposedAction @relation(fields: [workspaceId, clientId, actionId], references: [workspaceId, clientId, id], onDelete: Restrict)

  @@index([workspaceId, clientId, actionId, createdAt])
  @@index([actionId, approverId, createdAt])
}

/// Immutable execution attempts. Payloads contain sanitized remote state only;
/// provider credentials and bearer tokens are never persisted here.
model OptimizationActionExecution {
  id                        String    @id @default(cuid())
  workspaceId               String
  clientId                  String
  actionId                  String
  operation                 String // dry_run | execute | rollback
  status                    String // validating | validated | executing | succeeded | failed | blocked
  idempotencyKey            String    @unique
  requestedById             String
  requestedByRole           String
  actionFingerprint         String
  expectedRemoteFingerprint String
  observedRemoteFingerprint String?
  remoteBefore              Json?
  remoteAfter               Json?
  providerRequestId         String?
  errorCode                 String?
  errorMessage              String?
  createdAt                 DateTime  @default(now())
  completedAt               DateTime?

  workspace Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    OptimizationClient         @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Cascade)
  action    OptimizationProposedAction @relation(fields: [workspaceId, clientId, actionId], references: [workspaceId, clientId, id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, clientId, actionId, createdAt])
  @@index([actionId, operation, status])
}

/// Immutable retrospective comparison. The observed value is always derived
/// from the outcome snapshot; callers cannot supply it. Shadow evaluations
/// describe counterfactual policy behavior and never establish causality.
model OptimizationEvaluation {
  id                 String   @id @default(cuid())
  workspaceId        String
  clientId           String
  sourceSnapshotId   String
  outcomeSnapshotId  String
  analysisResultId   String?
  actionId           String?
  evaluationType     String // forecast_backtest | shadow_policy
  metric             String
  aggregation        String
  scope              Json
  predictedValue     Float
  actualValue        Float?
  baselineValue      Float?
  intervalLow        Float?
  intervalHigh       Float?
  intervalLevel      Float?
  predictionLocator  String
  absoluteError      Float?
  percentageError    Float?
  withinInterval     Boolean?
  directionalCorrect Boolean?
  sampleSize         Int
  minimumSampleSize  Int
  status             String // completed | inconclusive
  causalClaimAllowed Boolean  @default(false)
  guardrailResults   Json
  limitations        Json
  idempotencyKey     String   @unique
  createdById        String?
  evaluatedAt        DateTime @default(now())
  createdAt          DateTime @default(now())

  workspace       Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client          OptimizationClient          @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Cascade)
  sourceSnapshot  OptimizationSnapshot        @relation("EvaluationSourceSnapshot", fields: [workspaceId, clientId, sourceSnapshotId], references: [workspaceId, clientId, id], onDelete: Restrict)
  outcomeSnapshot OptimizationSnapshot        @relation("EvaluationOutcomeSnapshot", fields: [workspaceId, clientId, outcomeSnapshotId], references: [workspaceId, clientId, id], onDelete: Restrict)
  analysisResult  OptimizationAnalysisResult? @relation(fields: [analysisResultId], references: [id], onDelete: Restrict)
  action          OptimizationProposedAction? @relation(fields: [actionId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, clientId, id])
  @@index([workspaceId, clientId, evaluatedAt])
  @@index([sourceSnapshotId])
  @@index([outcomeSnapshotId])
  @@index([analysisResultId])
  @@index([actionId])
}

/// Append-only domain ledger. Application code exposes create/list only.
model OptimizationAuditEvent {
  id          String   @id @default(cuid())
  workspaceId String
  clientId    String
  snapshotId  String?
  actionId    String?
  actorId     String?
  eventType   String
  payload     Json
  createdAt   DateTime @default(now())

  workspace Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    OptimizationClient          @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Cascade)
  snapshot  OptimizationSnapshot?       @relation(fields: [workspaceId, clientId, snapshotId], references: [workspaceId, clientId, id], onDelete: Restrict)
  action    OptimizationProposedAction? @relation(fields: [workspaceId, clientId, actionId], references: [workspaceId, clientId, id], onDelete: Restrict)

  @@index([workspaceId, clientId, createdAt])
  @@index([snapshotId])
  @@index([actionId])
}

// ------------------------------------------------------
// REPORTES (White-Label Reports)
// ------------------------------------------------------
model Report {
  id          String    @id @default(cuid())
  workspaceId String
  projectId   String
  title       String
  slug        String    @unique // URL pública: /reportes/{slug}
  dateFrom    DateTime
  dateTo      DateTime
  data        Json // Snapshot inmutable: KPIs, timeSeries, topCreatives, pacing
  settings    Json? // White-label: logo, colors, footer text
  status      String    @default("active") // active, expired, archived
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([projectId])
  @@index([slug])
}

// ------------------------------------------------------
// AI METERING & FINOPS (Phase P1.5)
// ------------------------------------------------------

model AiRequest {
  id             String    @id @default(cuid())
  workspaceId    String
  idempotencyKey String    @unique // To prevent concurrent duplicated requests
  feature        String // e.g. "optimization_planner", "agent_reporting"
  status         String    @default("CREATED") // CREATED, RUNNING, SUCCEEDED, FAILED
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      AiRun[]
  usages    AiUsage[]

  @@index([workspaceId])
  @@index([status])
}

model AiRun {
  id          String @id @default(cuid())
  requestId   String
  workspaceId String

  provider              String // e.g. "gemini", "anthropic"
  model                 String // Requested model
  actualProviderModelId String // Actual model executed (e.g. "gemini-1.5-pro-latest")

  promptVersion   String?
  workflowVersion String?

  status String @default("RUNNING") // RUNNING, SUCCEEDED, FAILED, TIMEOUT

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  latencyMs   Int?

  inputTokens  Int @default(0)
  outputTokens Int @default(0)
  cachedTokens Int @default(0)

  providerCost Decimal? @db.Decimal(19, 4) // Null if unknown, real provider cost in USD
  currency     String   @default("USD")

  fallbackFromRunId String? // If this run was a fallback, point to failed run
  errorCode         String?

  request   AiRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([workspaceId])
}

model AiUsage {
  id                String   @id @default(cuid())
  workspaceId       String
  requestId         String?
  idempotencyKey    String   @unique // To prevent duplicate settlement records
  route             String
  model             String
  provider          String?
  tokensIn          Int      @default(0)
  tokensOut         Int      @default(0)
  providerCostUsd   Decimal? @db.Decimal(19, 4) // Exact cost from the provider
  customerChargeUsd Decimal? @db.Decimal(19, 4) // Price billed to the customer (ledger value)
  feature           String?
  createdAt         DateTime @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  request   AiRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([createdAt])
  @@index([requestId])
}

model AiModelPricing {
  id               String    @id @default(cuid())
  provider         String
  providerModelId  String
  inputPrice       Decimal   @db.Decimal(19, 6) // Cost per 1 token (or 1M, handled by calc logic)
  outputPrice      Decimal   @db.Decimal(19, 6)
  cachedInputPrice Decimal?  @db.Decimal(19, 6)
  currency         String    @default("USD")
  effectiveFrom    DateTime  @default(now())
  effectiveTo      DateTime?
  sourceMetadata   String? // URL or reference

  @@unique([provider, providerModelId, effectiveFrom])
}

model FeaturePricing {
  id          String   @id @default(cuid())
  feature     String   @unique // e.g. "optimization_planner"
  pricingMode String // INCLUDED, CREDITS, USAGE_BASED, FIXED, OVERAGE
  fixedCost   Decimal? @db.Decimal(19, 4) // If FIXED
  creditsCost Int? // If CREDITS
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkspaceEntitlement {
  id                     String   @id @default(cuid())
  workspaceId            String   @unique
  saasPlan               String   @default("FREE") // SaaS product plan
  allowedFeatures        String[] // ["AI_GENERATION", "AUTOPILOT"]
  monthlyAiBudget        Decimal? @db.Decimal(19, 4) // Financial limit in USD
  autopilotEnabled       Boolean  @default(false)
  dailyAutopilotAiBudget Decimal? @db.Decimal(19, 4)
  maxAiCostPerRun        Decimal? @db.Decimal(19, 4)
  availableCredits       Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------
// RATE LIMITING
// ------------------------------------------------------
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

// ------------------------------------------------------
// STRIPE BILLING
// ------------------------------------------------------
model BillingCustomer {
  id               String    @id @default(cuid())
  workspaceId      String    @unique
  stripeCustomerId String    @unique
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String    @id @default(cuid())
  workspaceId          String    @unique
  stripeSubscriptionId String    @unique
  status               String
  plan                 String
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model BillingEvent {
  id               String    @id @default(cuid())
  stripeEventId    String    @unique
  eventType        String
  livemode         Boolean
  processingStatus String    @default("pending") // pending, processed, failed
  error            String?   @db.Text
  receivedAt       DateTime  @default(now())
  processedAt      DateTime?
}

model BillingUsageEvent {
  id                         String    @id @default(cuid())
  workspaceId                String
  aiUsageId                  String    @unique
  stripeMeterEventIdentifier String    @unique
  meterName                  String
  quantity                   Int
  status                     String    @default("PENDING") // PENDING, PROCESSING, SENT, FAILED
  attempts                   Int       @default(0)
  lastError                  String?   @db.Text
  sentAt                     DateTime?
  reportedAt                 DateTime  @default(now())
  lastAttemptAt              DateTime?
  nextAttemptAt              DateTime?
}

model Invoice {
  id               String    @id @default(cuid())
  workspaceId      String
  stripeInvoiceId  String    @unique
  status           String
  currency         String
  amountDue        Int
  amountPaid       Int
  hostedInvoiceUrl String?   @db.Text
  billingPeriod    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// COMMERCIAL & FINANCIAL OS (CF-0 to CF-11)
// -----------------------------------------------------------------------------

model WorkspaceAiBudgetBalance {
  id                         String   @id @default(cuid())
  workspaceId                String
  period                     String // e.g. "2026-08"
  customerAiAllowance        Decimal  @default(0.00) @db.Decimal(19, 4) // Maximum billable to customer
  customerBilledUsd          Decimal  @default(0.00) @db.Decimal(19, 4) // Actual amount billed to customer
  customerReservedUsd        Decimal  @default(0.00) @db.Decimal(19, 4) // Amount currently locked for in-flight requests
  internalProviderSpendLimit Decimal  @default(0.00) @db.Decimal(19, 4) // Hard limit on internal API costs
  internalProviderCostUsd    Decimal  @default(0.00) @db.Decimal(19, 4) // Actual API cost incurred
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, period])
  @@index([workspaceId, period])
}

model AiReservationLedger {
  id              String    @id @default(cuid())
  workspaceId     String
  idempotencyKey  String    @unique
  feature         String
  reservedCostUsd Decimal   @db.Decimal(19, 4)
  status          String    @default("RESERVED") // RESERVED, SETTLED, RELEASED
  createdAt       DateTime  @default(now())
  settledAt       DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

model ExternalCostRate {
  id            String    @id @default(cuid())
  provider      String // Vercel, Neon, Stripe, OpenAI, Anthropic, Google
  component     String // e.g., platform_fee, compute, storage, gpt-4o-input
  unit          String // e.g., month, 1M_tokens, GB, charge
  amount        Decimal   @db.Decimal(19, 6)
  currency      String    @default("USD")
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  sourceUrl     String?   @db.Text
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
}

model Plan {
  id          String        @id @default(cuid())
  key         String        @unique // STARTER, PRO, AGENCY, ENTERPRISE
  name        String
  description String?
  versions    PlanVersion[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model PlanVersion {
  id             String    @id @default(cuid())
  planId         String
  version        Int
  status         String    @default("DRAFT") // DRAFT, SCHEDULED, ACTIVE, RETIRED
  effectiveFrom  DateTime  @default(now())
  effectiveTo    DateTime?
  basePriceUsd   Decimal   @db.Decimal(19, 4)
  annualPriceUsd Decimal   @db.Decimal(19, 4)
  includedSeats  Int       @default(1)
  includedWs     Int       @default(1) // Workspaces/Projects

  plan      Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  modules   PlanModule[]
  prices    PlanPrice[]
  createdAt DateTime     @default(now())
}

model PlanPrice {
  id            String      @id @default(cuid())
  planVersionId String
  stripePriceId String
  billingPeriod String // MONTHLY, ANNUALLY
  planVersion   PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
}

model Module {
  id                 String       @id @default(cuid())
  key                String       @unique
  name               String
  description        String?      @db.Text
  category           String
  status             String       @default("ACTIVE")
  implementationType String // FULL_STACK, BACKEND, FRONTEND, INFRASTRUCTURE
  isPurchasable      Boolean      @default(false)
  isAddon            Boolean      @default(false)
  frontendRoute      String?
  planModules        PlanModule[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model PlanModule {
  id            String @id @default(cuid())
  planVersionId String
  moduleId      String
  inclusion     String // INCLUDED, OPTIONAL, NOT_AVAILABLE
  usageLimit    Int?

  planVersion PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  module      Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([planVersionId, moduleId])
}

model AiPackage {
  id        String             @id @default(cuid())
  key       String             @unique // GEMINI, GPT, CLAUDE, SMART
  name      String
  versions  AiPackageVersion[]
  createdAt DateTime           @default(now())
}

model AiPackageVersion {
  id                String  @id @default(cuid())
  packageId         String
  status            String  @default("ACTIVE")
  feeMode           String  @default("INCLUDED_IN_PLAN") // INCLUDED_IN_PLAN, SEPARATE, WAIVED, CUSTOM
  baseFeeUsd        Decimal @db.Decimal(19, 4)
  includedUnits     Int     @default(0)
  variableUnitPrice Decimal @db.Decimal(19, 6) // price per unit

  package   AiPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

model BillingLedgerEntry {
  id          String    @id @default(cuid())
  workspaceId String
  type        String // SUBSCRIPTION, MODULE, AI_BASE, AI_USAGE, CREDIT, TAX
  source      String // Stripe Invoice ID, etc
  sourceId    String?
  quantity    Int       @default(1)
  unit        String // month, ai_billable_unit
  unitAmount  Decimal   @db.Decimal(19, 4)
  subtotal    Decimal   @db.Decimal(19, 4)
  currency    String    @default("USD")
  periodStart DateTime?
  periodEnd   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model BillingProfile {
  id             String  @id @default(cuid())
  workspaceId    String  @unique
  legalName      String?
  entityType     String? // BUSINESS, INDIVIDUAL
  billingEmail   String?
  country        String?
  address        String? @db.Text
  taxIdType      String?
  taxId          String?
  fiscalMetadata Json?

  notifyOwner           Boolean @default(true)
  paymentFailedEmail    Boolean @default(true)
  invoiceAvailableEmail Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model BillingRecoveryPolicy {
  id                     String   @id @default(cuid())
  version                Int      @default(1)
  gracePeriodDays        Int      @default(3)
  notificationSchedule   Json     @default("[]") // [1, 2, 3] days
  aiRestrictionPointDays Int      @default(3)
  serviceRestrictionDays Int      @default(7)
  unpaidBehavior         String   @default("suspend") // suspend | cancel
  cancellationBehavior   String   @default("revoke_access")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model FiscalDocument {
  id           String    @id @default(cuid())
  workspaceId  String
  invoiceId    String?
  status       String // ISSUED, CANCELED
  uuid         String?   @unique // CFDI UUID
  xmlUrl       String?
  pdfUrl       String?
  issuedAt     DateTime?
  canceledAt   DateTime?
  jurisdiction String    @default("MX")
  metadata     Json?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

model BillingNotification {
  id             String    @id @default(cuid())
  workspaceId    String
  invoiceId      String?
  type           String // INVOICE_AVAILABLE, PAYMENT_FAILED, PAST_DUE, etc.
  recipient      String
  channel        String // EMAIL, WHATSAPP, IN_APP
  status         String    @default("PENDING") // PENDING, SENT, FAILED
  idempotencyKey String    @unique
  attempts       Int       @default(0)
  providerMsgId  String?
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model BillingRecoveryCase {
  id             String    @id @default(cuid())
  workspaceId    String
  invoiceId      String
  status         String    @default("ACTIVE") // ACTIVE, RESOLVED, CANCELED
  gracePeriodEnd DateTime?
  restrictedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
