{
  "name": "flowchart",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/db-sync.mjs && prisma generate && node scripts/patch-prisma-types.mjs || true && next build",
    "db:sync": "node scripts/db-sync.mjs",
    "release": "node scripts/db-sync.mjs && prisma generate && node scripts/patch-prisma-types.mjs || true && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate && node scripts/patch-prisma-types.mjs",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:reencrypt": "tsx scripts/reencrypt-tokens.ts",
    "postinstall": "prisma generate && (node scripts/patch-prisma-types.mjs || true)",
    "docs:graph": "node scripts/docs-graph.mjs",
    "docs:validate": "node scripts/docs-graph.mjs --validate"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google-analytics/data": "^6.1.0",
    "@next/third-parties": "^16.2.7",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.9.0",
    "@sentry/nextjs": "^10.64.0",
    "@swc/helpers": "^0.5.23",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@vercel/blob": "^2.4.0",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.40.0",
    "google-ads-api": "^24.1.0",
    "jszip": "^3.10.1",
    "lenis": "^1.3.25",
    "lucide-react": "^1.16.0",
    "next": "16.2.11",
    "next-auth": "^4.24.14",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-grid-layout": "^2.2.3",
    "recharts": "^3.8.1",
    "resend": "^6.12.4",
    "stripe": "^22.5.0",
    "workflow": "^4.5.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.2.11",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
